   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"F42apd", "*", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"S", "[", 
            RowBox[{
             RowBox[{"m", "[", "1", "]"}], ",", 
             RowBox[{"m", "[", "3", "]"}]}], "]"}]}], "-", 
          RowBox[{"S", "[", 
           RowBox[{
            RowBox[{"m", "[", "1", "]"}], ",", 
            RowBox[{"m", "[", "4", "]"}]}], "]"}], "-", 
          RowBox[{"S", "[", 
           RowBox[{
            RowBox[{"m", "[", "2", "]"}], ",", 
            RowBox[{"m", "[", "3", "]"}]}], "]"}], "-", 
          RowBox[{"S", "[", 
           RowBox[{
