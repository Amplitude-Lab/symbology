Cell[BoxData[
 RowBox[{
  RowBox[{
  "string", "=", 
   "\"\<sqrt1a = sqrt(v1^2 - 4*u2 + 2*v1*v2 + v2^2),\nsqrt1b = sqrt(1 - 2*u1 \
+ u1^2 - 2*u3 - 2*u1*u3 + u3^2),\nsqrt2a = sqrt(u1^2 - 2*u1*v1 + v1^2 + \
2*u1^2*u2 - \n        2*u1*v1*u2 + u1^2*u2^2 - 2*u1^2*v2 + 4*u1*v1*v2 - \n    \
    2*v1^2*v2 - 2*u1^2*u2*v2 + 2*u1*v1*u2*v2 + \n        u1^2*v2^2 - \
2*u1*v1*v2^2 + v1^2*v2^2 - 2*u1*v1*u3 + \n        2*v1^2*u3 - 2*u1*u2*u3 - \
2*v1*u2*u3 + 2*u1*v1*u2*u3 - \n        2*u1*u2^2*u3 + 2*u1*v1*v2*u3 - \
2*v1^2*v2*u3 + \n        2*u1*u2*v2*u3 + 2*v1*u2*v2*u3 + v1^2*u3^2 - \n       \
 2*v1*u2*u3^2 + u2^2*u3^2), \nsqrt2b = sqrt(u1^2*u2^2 - 2*u1*u2*v2 - \
2*u1^2*u2*v2 + \n        2*u1*v1*u2*v2 + v2^2 + 2*u1*v2^2 + u1^2*v2^2 - \n    \
    2*v1*v2^2 - 2*u1*v1*v2^2 + v1^2*v2^2 - 2*u1*u2*u3 + \n        \
2*u1*v1*u2*u3 - 2*u1*u2^2*u3 - 2*v2*u3 - 2*u1*v2*u3 + \n        4*v1*v2*u3 + \
2*u1*v1*v2*u3 - 2*v1^2*v2*u3 - \n        2*u2*v2*u3 + 2*u1*u2*v2*u3 + \
2*v1*u2*v2*u3 + u3^2 - \n        2*v1*u3^2 + v1^2*u3^2 + 2*u2*u3^2 - \
2*v1*u2*u3^2 + \n        u2^2*u3^2), \nsqrt3 = sqrt(u2^2 - 2*u1*u2^2 + \
u1^2*u2^2 + \n        2*u1*u2*v2 - 2*u1^2*u2*v2 - 2*v1*u2*v2 + \n        \
2*u1*v1*u2*v2 + u1^2*v2^2 - 2*u1*v1*v2^2 + \n        v1^2*v2^2 - 4*u1*u2*u3 + \
2*v1*u2*u3 + 2*u1*v1*u2*u3 - \n        2*u2^2*u3 - 2*u1*u2^2*u3 + \
2*u1*v1*v2*u3 - \n        2*v1^2*v2*u3 + 2*u1*u2*v2*u3 + 2*v1*u2*v2*u3 + \n   \
     v1^2*u3^2 - 2*v1*u2*u3^2 + u2^2*u3^2) }\>\""}], ";"}]], "Input",
