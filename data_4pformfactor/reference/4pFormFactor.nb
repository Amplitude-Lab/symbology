             RowBox[{"S", "[", 
              RowBox[{
               RowBox[{"m", "[", "6", "]"}], ",", 
               RowBox[{"m", "[", "6", "]"}]}], "]"}]}], ")"}]}]}], ")"}]}], "//",
        "Expand"}], ")"}], "/.", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"S", "[", "a__", "]"}], "*", 
        RowBox[{"S", "[", "b__", "]"}]}], ":>", 
       RowBox[{"Total", "[", 
        RowBox[{"S", "@@@", 
         RowBox[{"(", 
          RowBox[{"shuffleW", "[", 
           RowBox[{
            RowBox[{"{", "a", "}"}], ",", 
            RowBox[{"{", "b", "}"}]}], "]"}], ")"}]}], "]"}]}], "}"}]}], "//", 
