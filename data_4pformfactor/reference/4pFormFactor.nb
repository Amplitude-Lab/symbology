            RowBox[{"m", "[", "4", "]"}]}], "]"}], "-", 
          RowBox[{"S", "[", 
           RowBox[{
            RowBox[{"m", "[", "3", "]"}], ",", 
            RowBox[{"m", "[", "1", "]"}]}], "]"}], "-", 
          RowBox[{"S", "[", 
           RowBox[{
            RowBox[{"m", "[", "3", "]"}], ",", 
            RowBox[{"m", "[", "2", "]"}]}], "]"}], "-", 
          RowBox[{"S", "[", 
           RowBox[{
            RowBox[{"m", "[", "4", "]"}], ",", 
            RowBox[{"m", "[", "1", "]"}]}], "]"}], "-", 
          RowBox[{"S", "[", 
           RowBox[{
            RowBox[{"m", "[", "4", "]"}], ",", 
            RowBox[{"m", "[", "2", "]"}]}], "]"}], "+", 
          RowBox[{"2", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"S", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"m", "[", "1", "]"}], "+", 
                RowBox[{"m", "[", "3", "]"}]}], ",", 
               RowBox[{
                RowBox[{"m", "[", "1", "]"}], "+", 
                RowBox[{"m", "[", "3", "]"}]}]}], "]"}], "-", 
             RowBox[{"S", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"m", "[", "1", "]"}], "+", 
                RowBox[{"m", "[", "3", "]"}]}], ",", 
               RowBox[{"m", "[", "6", "]"}]}], "]"}], "-", 
