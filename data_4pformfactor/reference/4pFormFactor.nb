Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "SymbolCollect", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "SymbolCollect", "]"}], "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\"\<replacement\>\"", "->", 
      RowBox[{"{", "}"}]}], ",", 
     RowBox[{"\"\<select\>\"", "->", "True"}], ",", 
     RowBox[{"\"\<head\>\"", "->", "SB"}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"SymbolCollect", "[", 
    RowBox[{"exp_", ",", "p_", ",", 
     RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "l", ",", "list", ",", "temp", ",", "tem", ",", "gcd", ",", "coef", ",",
        "slist", ",", "prod"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Head", "[", "exp", "]"}], "===", "Plus"}], ",", 
        RowBox[{"list", "=", 
         RowBox[{"List", "@@", "exp"}]}], ",", 
        RowBox[{"list", "=", "exp"}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"l", "=", 
       RowBox[{"Length", "[", 
        RowBox[{
         RowBox[{"Cases", "[", 
          RowBox[{"exp", ",", "_SB", ",", "Infinity"}], "]"}], "[", 
         RowBox[{"[", "1", "]"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      
      RowBox[{"list", "=", 
       RowBox[{"GatherBy", "[", 
        RowBox[{
         RowBox[{"List", "@@", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"list", "/.", 
              RowBox[{"OptionValue", "[", "\"\<replacement\>\"", "]"}]}], "//",
              "Total"}], "//", "Expand"}], ")"}]}], ",", 
         RowBox[{
          RowBox[{"Cases", "[", 
           RowBox[{
            RowBox[{"{", "#", "}"}], ",", 
            RowBox[{
             RowBox[{
              RowBox[{"OptionValue", "[", "\"\<head\>\"", "]"}], "[", 
              RowBox[{"a___", ",", "_", ",", 
               RowBox[{"c___", "/;", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"Length", "[", 
                   RowBox[{"{", "c", "}"}], "]"}], "==", 
                  RowBox[{"l", "-", "p"}]}], ")"}]}]}], "]"}], "->", 
             RowBox[{"{", 
              RowBox[{"a", ",", "c"}], "}"}]}], ",", "Infinity"}], "]"}], 
          "&"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"temp", "=", 
       RowBox[{
        RowBox[{"Reap", "[", "\[IndentingNewLine]", 
         RowBox[{"Do", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"tem", "=", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"list", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], "//", "Total"}], "//", 
               "Factor"}], ")"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"slist", "=", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"Cases", "[", 
                RowBox[{"tem", ",", 
                 RowBox[{
                  RowBox[{"OptionValue", "[", "\"\<head\>\"", "]"}], "[", 
                  "__", "]"}], ",", "Infinity"}], "]"}], "//", 
               "DeleteDuplicates"}], ")"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"slist", "===", 
               RowBox[{"{", "}"}]}], ",", "tem", ",", 
              RowBox[{
               RowBox[{"coef", "=", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Coefficient", "[", 
                   RowBox[{"tem", ",", "#"}], "]"}], "&"}], "/@", "slist"}]}],
                ";", 
               RowBox[{"gcd", "=", 
                RowBox[{"GCD", "[", 
                 RowBox[{"Sequence", "@@", "coef"}], "]"}]}], ";", 
               RowBox[{"coef", "=", 
                RowBox[{"coef", "/", "gcd"}]}], ";", 
               RowBox[{"prod", "=", 
                RowBox[{"Product", "[", 
                 RowBox[{
                  RowBox[{"Power", "[", 
                   RowBox[{
                    RowBox[{"slist", "[", 
                    RowBox[{"[", 
                    RowBox[{"j", ",", "p"}], "]"}], "]"}], ",", 
                    RowBox[{"coef", "[", 
                    RowBox[{"[", "j", "]"}], "]"}]}], "]"}], ",", 
                  RowBox[{"{", 
                   RowBox[{"j", ",", "1", ",", 
                    RowBox[{"Length", "[", "slist", "]"}]}], "}"}]}], "]"}]}],
                ";", "\[IndentingNewLine]", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"Numerator", "[", "prod", "]"}], "/.", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"m", "[", "a_", "]"}], ":>", "a"}], "}"}]}], 
                   ")"}], ">", 
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"Denominator", "[", "prod", "]"}], "/.", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"m", "[", "a_", "]"}], ":>", "a"}], "}"}]}], 
                   ")"}]}], ",", 
                 RowBox[{"Sow", "[", 
                  RowBox[{"gcd", "*", 
                   RowBox[{
                    RowBox[{"OptionValue", "[", "\"\<head\>\"", "]"}], "[", 
                    RowBox[{
                    RowBox[{"Sequence", "@@", 
                    RowBox[{"(", 
                    RowBox[{"Take", "[", 
                    RowBox[{
                    RowBox[{"slist", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], ",", 
                    RowBox[{"p", "-", "1"}]}], "]"}], ")"}]}], ",", "prod", 
                    ",", 
                    RowBox[{"Sequence", "@@", 
                    RowBox[{"(", 
                    RowBox[{"Take", "[", 
                    RowBox[{
                    RowBox[{"slist", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], ",", 
                    RowBox[{"p", "-", "l"}]}], "]"}], ")"}]}]}], "]"}]}], 
                  "]"}], ",", "\[IndentingNewLine]", 
                 RowBox[{"Sow", "[", 
                  RowBox[{
                   RowBox[{"-", "gcd"}], "*", 
                   RowBox[{
                    RowBox[{"OptionValue", "[", "\"\<head\>\"", "]"}], "[", 
                    RowBox[{
                    RowBox[{"Sequence", "@@", 
                    RowBox[{"(", 
                    RowBox[{"Take", "[", 
                    RowBox[{
                    RowBox[{"slist", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], ",", 
                    RowBox[{"p", "-", "1"}]}], "]"}], ")"}]}], ",", 
                    RowBox[{
                    RowBox[{"1", "/", "prod"}], "//", "Factor"}], ",", 
                    RowBox[{"Sequence", "@@", 
                    RowBox[{"(", 
                    RowBox[{"Take", "[", 
                    RowBox[{
                    RowBox[{"slist", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], ",", 
                    RowBox[{"p", "-", "l"}]}], "]"}], ")"}]}]}], "]"}]}], 
                  "]"}]}], "\[IndentingNewLine]", "]"}]}]}], 
             "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "1", ",", 
             RowBox[{"Length", "[", "list", "]"}]}], "}"}]}], "]"}], 
         "\[IndentingNewLine]", "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"2", ",", "1"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      
      RowBox[{"Return", "[", "temp", "]"}], ";"}]}], "\[IndentingNewLine]", 
    "]"}]}], ";"}]}], "Input",
