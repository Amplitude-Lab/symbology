Cell[BoxData[
 RowBox[{
  RowBox[{"R42symbolGt", "=", 
   RowBox[{
    RowBox[{"Reap", "[", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"tem", "=", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"R42symbolG", "[", 
              RowBox[{"[", "i", "]"}], "]"}], "//", 
             RowBox[{
              RowBox[{"DeleteCases", "[", 
               RowBox[{"#", ",", 
                RowBox[{"_", "?", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"!", 
                    RowBox[{"MemberQ", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"m", "[", "1", "]"}], ",", 
                    RowBox[{"m", "[", "2", "]"}], ",", 
                    RowBox[{"m", "[", "3", "]"}], ",", 
                    RowBox[{"m", "[", "4", "]"}], ",", 
                    RowBox[{"m", "[", "9", "]"}], ",", 
                    RowBox[{"m", "[", "10", "]"}], ",", 
                    RowBox[{"m", "[", "11", "]"}], ",", 
                    RowBox[{"m", "[", "12", "]"}]}], "}"}], ",", 
                    RowBox[{
                    RowBox[{"Cases", "[", 
                    RowBox[{
                    RowBox[{"{", "#", "}"}], ",", 
                    RowBox[{
                    RowBox[{"SB", "[", 
                    RowBox[{"_", ",", "_", ",", "_", ",", "a_"}], "]"}], "->",
                     "a"}], ",", "Infinity"}], "]"}], "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}], "&"}], 
                  ")"}]}]}], "]"}], "&"}]}], "//", "Total"}], "//", 
           "Factor"}], ")"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"slist", "=", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Cases", "[", 
            RowBox[{"tem", ",", 
             RowBox[{"SB", "[", 
              RowBox[{"_", ",", "_", ",", "_", ",", "_"}], "]"}], ",", 
             "Infinity"}], "]"}], "//", "DeleteDuplicates"}], ")"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"slist", "===", 
           RowBox[{"{", "}"}]}], ",", "tem", ",", 
          RowBox[{
           RowBox[{"coef", "=", 
            RowBox[{
             RowBox[{
              RowBox[{"Coefficient", "[", 
               RowBox[{"tem", ",", "#"}], "]"}], "&"}], "/@", "slist"}]}], 
           ";", 
           RowBox[{"gcd", "=", 
            RowBox[{"GCD", "[", 
             RowBox[{"Sequence", "@@", "coef"}], "]"}]}], ";", 
           RowBox[{"coef", "=", 
            RowBox[{"coef", "/", "gcd"}]}], ";", 
           RowBox[{"prod", "=", 
            RowBox[{"Product", "[", 
             RowBox[{
              RowBox[{"Power", "[", 
               RowBox[{
                RowBox[{"slist", "[", 
                 RowBox[{"[", 
                  RowBox[{"j", ",", "4"}], "]"}], "]"}], ",", 
                RowBox[{"coef", "[", 
                 RowBox[{"[", "j", "]"}], "]"}]}], "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"j", ",", "1", ",", 
                RowBox[{"Length", "[", "slist", "]"}]}], "}"}]}], "]"}]}], 
           ";", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"FreeQ", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"prod", "/.", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"m", "[", "a_", "]"}], ":>", 
                   RowBox[{"S", "*", 
