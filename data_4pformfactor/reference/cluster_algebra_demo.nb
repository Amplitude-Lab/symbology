               RowBox[{"[", "1", "]"}], "]"}], ",", "int3"}], "]"}]}], 
           "}"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{"three", " ", "pairs", " ", "of", " ", "variables"}], 
          "*)"}], "\[IndentingNewLine]", 
         RowBox[{"tem", "=", 
          RowBox[{
           RowBox[{
            RowBox[{"ContainsAll", "[", 
             RowBox[{"int", ",", "#"}], "]"}], "&"}], "/@", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"p1", "[", 
              RowBox[{"[", "1", "]"}], "]"}], ",", 
             RowBox[{"p2", "[", 
              RowBox[{"[", "1", "]"}], "]"}], ",", 
             RowBox[{"p3", "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], "}"}]}]}], ";", 
         "\[IndentingNewLine]", 
