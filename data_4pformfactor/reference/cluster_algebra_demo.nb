Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "RandomZs", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"RandomZs", "::", "usage"}], "=", 
   "\"\<RandomZs[n] generate a set of positive ordered list for G(4,n) which \
also satisfies the kinematic conditions by using algorithm in the ancillary \
file of 1911.09106. The Option \\\"positive\\\"->False can generate a set of \
random ordered list. The last two denote infinity line.\>\""}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "RandomZs", "]"}], "=", 
   RowBox[{"{", 
    RowBox[{"\"\<positive\>\"", "->", "True"}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"RandomZs", "[", "n_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"pl", ",", "tl", ",", "rl", ",", 
       RowBox[{"row", "=", 
        RowBox[{"{", "}"}]}], ",", "i"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"Not", "@", 
         RowBox[{"OptionValue", "[", "\"\<positive\>\"", "]"}]}], ",", 
        RowBox[{"Return", "[", 
         RowBox[{"Append", "[", 
          RowBox[{
           RowBox[{"RandomPrime", "[", 
            RowBox[{"10000", ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"n", "-", "1"}], ",", "4"}], "}"}]}], "]"}], ",", 
           RowBox[{"Prepend", "[", 
            RowBox[{
             RowBox[{"RandomPrime", "[", 
              RowBox[{"10000", ",", "3"}], "]"}], ",", "0"}], "]"}]}], "]"}], 
         "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"pl", "=", 
       RowBox[{"(", 
        RowBox[{"Accumulate", "[", 
         RowBox[{"RandomInteger", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"1", ",", "20"}], "}"}], ",", 
           RowBox[{"n", "+", "6"}]}], "]"}], "]"}], ")"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"tl", "=", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{"1", ",", 
         RowBox[{"n", "+", "6"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"row", "=", 
       RowBox[{"Prepend", "[", 
        RowBox[{
         RowBox[{"Delete", "[", 
          RowBox[{
           RowBox[{"Partition", "[", 
            RowBox[{
             RowBox[{"Riffle", "[", 
              RowBox[{"pl", ",", "tl"}], "]"}], ",", "2"}], "]"}], ",", 
           RowBox[{"-", "1"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"0", ",", "1"}], "}"}]}], "]"}]}], ";", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{
        "the", " ", "first", " ", "one", " ", "is", " ", "special", " ", 
         "corresponding", " ", "to", " ", "the", " ", "last", " ", "light"}], 
        "-", 
        RowBox[{"like", " ", "momentum", " ", "p_n", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", "0"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"x", ",", "x"}], "}"}]}], "}"}], " ", "which", " ", 
         "also", " ", 
         RowBox[{"doesn", "'"}], "t", " ", "affect", " ", "the", " ", 
         "positive", " ", "order"}]}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"Do", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"rl", "=", 
          RowBox[{"RandomInteger", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"1", ",", "10"}], "}"}], ",", 
            RowBox[{"n", "+", "6"}]}], "]"}]}], ";", 
         RowBox[{"(*", 
          RowBox[{
          "mulitipling", " ", "positive", " ", "random", " ", "integer", " ", 
           
           RowBox[{"doesn", "'"}], "t", " ", "change", " ", "the", " ", 
           "positivity"}], "*)"}], "\[IndentingNewLine]", 
         RowBox[{"row", "=", 
          RowBox[{"Prepend", "[", 
           RowBox[{
            RowBox[{"Delete", "[", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"Append", "[", 
                 RowBox[{"#", ",", "1"}], "]"}], "&"}], "/@", 
               RowBox[{"Accumulate", "[", 
                RowBox[{"rl", "*", "row"}], "]"}]}], ",", 
              RowBox[{"-", "1"}]}], "]"}], ",", 
            RowBox[{"UnitVector", "[", 
             RowBox[{
              RowBox[{"i", "+", "2"}], ",", 
              RowBox[{"i", "+", "2"}]}], "]"}]}], "]"}]}], ";"}], 
        "\[IndentingNewLine]", ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", "2"}], "}"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"rl", "=", 
       RowBox[{"RandomPrime", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", "100"}], "}"}], ",", 
         RowBox[{"n", "+", "6"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"row", "=", 
       RowBox[{"row", "*", "rl"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Return", "[", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"row", "[", 
            RowBox[{"[", 
             RowBox[{"3", ";;", 
              RowBox[{"-", "5"}]}], "]"}], "]"}], "//", "Reverse"}], ")"}], 
         ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", "0", ",", "0", ",", "1"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", "0", ",", "1", ",", "0"}], "}"}]}], "}"}]}], 
        "]"}], "]"}], ";"}]}], 
    RowBox[{"(*", 
     RowBox[{
     "the", " ", "last", " ", "two", " ", "denote", " ", "the", " ", 
      "infinity", " ", "line"}], "*)"}], "\[IndentingNewLine]", "]"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.937253845641361*^9, 3.937253966152325*^9}, {
   3.9372545292995377`*^9, 3.9372545644938183`*^9}, 3.937254607057152*^9, 
   3.937256641401783*^9, {3.937259590155905*^9, 3.93725961015419*^9}, {
