Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "MutateY", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"MutateY", "::", "usage"}], "=", 
   "\"\<MutateY[B,y,k] mutate the exchange matrix B and the corresponding X \
coordinates y in direction k\>\""}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"MutateY", "[", 
    RowBox[{"B_", ",", "y_", ",", "k_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"Bp", ",", "yp", ",", "l", ",", "tem"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"l", "=", 
       RowBox[{"B", "[", 
        RowBox[{"[", "k", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"yp", "=", "y"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Bp", "=", 
       RowBox[{"Table", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"i", "==", "k"}], "||", 
            RowBox[{"j", "==", "k"}]}], ",", 
           RowBox[{"-", 
            RowBox[{"B", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", "j"}], "]"}], "]"}]}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"B", "[", 
                RowBox[{"[", 
                 RowBox[{"i", ",", "k"}], "]"}], "]"}], ">", "0"}], "&&", 
              RowBox[{
               RowBox[{"B", "[", 
                RowBox[{"[", 
                 RowBox[{"k", ",", "j"}], "]"}], "]"}], ">", "0"}]}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"B", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", "j"}], "]"}], "]"}], "+", 
              RowBox[{
               RowBox[{"B", "[", 
                RowBox[{"[", 
                 RowBox[{"i", ",", "k"}], "]"}], "]"}], "*", 
               RowBox[{"B", "[", 
                RowBox[{"[", 
                 RowBox[{"k", ",", "j"}], "]"}], "]"}]}]}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"B", "[", 
                  RowBox[{"[", 
                   RowBox[{"i", ",", "k"}], "]"}], "]"}], "<", "0"}], "&&", 
                RowBox[{
                 RowBox[{"B", "[", 
                  RowBox[{"[", 
                   RowBox[{"k", ",", "j"}], "]"}], "]"}], "<", "0"}]}], ",", 
               RowBox[{
                RowBox[{"B", "[", 
                 RowBox[{"[", 
                  RowBox[{"i", ",", "j"}], "]"}], "]"}], "-", 
                RowBox[{
                 RowBox[{"B", "[", 
                  RowBox[{"[", 
                   RowBox[{"i", ",", "k"}], "]"}], "]"}], "*", 
                 RowBox[{"B", "[", 
                  RowBox[{"[", 
                   RowBox[{"k", ",", "j"}], "]"}], "]"}]}]}], ",", 
               RowBox[{"B", "[", 
                RowBox[{"[", 
                 RowBox[{"i", ",", "j"}], "]"}], "]"}]}], "]"}]}], 
            "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", "]"}], 
         "\[IndentingNewLine]", ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", 
           RowBox[{"Length", "[", "B", "]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", "1", ",", 
           RowBox[{"Length", "[", 
            RowBox[{"B", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "]"}]}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"yp", "=", 
       RowBox[{
        RowBox[{"Table", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"i", "==", "k"}], ",", 
            RowBox[{"(*", 
             RowBox[{
              RowBox[{"Print", "[", 
               RowBox[{"\"\<y\>\"", "<>", 
                RowBox[{"ToString", "[", "k", "]"}], "<>", "\"\<-> 1/y\>\"", "<>", \

                RowBox[{"ToString", "[", "k", "]"}]}], "]"}], ";"}], "*)"}], 
            RowBox[{"1", "/", 
             RowBox[{"y", "[", 
              RowBox[{"[", "i", "]"}], "]"}]}], ",", "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"B", "[", 
                RowBox[{"[", 
                 RowBox[{"k", ",", "i"}], "]"}], "]"}], "<=", "0"}], ",", 
              RowBox[{"(*", 
               RowBox[{
                RowBox[{"Print", "[", 
                 RowBox[{"\"\<y\>\"", "<>", 
                  RowBox[{"ToString", "[", "i", "]"}], "<>", "\"\<->y\>\"", "<>", 
                  RowBox[{"ToString", "[", "i", "]"}], "<>", "\"\<*(1+y\>\"", 
                  "<>", 
                  RowBox[{"ToString", "[", "k", "]"}], "<>", "\"\<)^\>\"", "<>", 
                  RowBox[{"ToString", "[", 
                   RowBox[{"-", 
                    RowBox[{"B", "[", 
                    RowBox[{"[", 
                    RowBox[{"k", ",", "i"}], "]"}], "]"}]}], "]"}]}], "]"}], 
                ";"}], "*)"}], 
              RowBox[{
               RowBox[{"y", "[", 
                RowBox[{"[", "i", "]"}], "]"}], "*", 
               RowBox[{"Power", "[", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"y", "[", 
                    RowBox[{"[", "k", "]"}], "]"}], "+", "1"}], ")"}], ",", 
                 RowBox[{"-", 
                  RowBox[{"B", "[", 
                   RowBox[{"[", 
                    RowBox[{"k", ",", "i"}], "]"}], "]"}]}]}], "]"}]}], ",", 
              RowBox[{"(*", 
               RowBox[{
                RowBox[{"Print", "[", 
                 RowBox[{"\"\<y\>\"", "<>", 
                  RowBox[{"ToString", "[", "i", "]"}], "<>", "\"\<->y\>\"", "<>", 
                  RowBox[{"ToString", "[", "i", "]"}], "<>", 
                  "\"\<*(1+1/y\>\"", "<>", 
                  RowBox[{"ToString", "[", "k", "]"}], "<>", "\"\<)^\>\"", "<>", 
                  RowBox[{"ToString", "[", 
                   RowBox[{"-", 
                    RowBox[{"B", "[", 
                    RowBox[{"[", 
                    RowBox[{"k", ",", "i"}], "]"}], "]"}]}], "]"}]}], "]"}], 
                ";"}], "*)"}], 
              RowBox[{
               RowBox[{"y", "[", 
                RowBox[{"[", "i", "]"}], "]"}], "*", 
               RowBox[{"Power", "[", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"1", "/", 
                    RowBox[{"y", "[", 
                    RowBox[{"[", "k", "]"}], "]"}]}], "+", "1"}], ")"}], ",", 
                 
                 RowBox[{"-", 
                  RowBox[{"B", "[", 
                   RowBox[{"[", 
                    RowBox[{"k", ",", "i"}], "]"}], "]"}]}]}], "]"}]}]}], 
             "]"}]}], "]"}], "\[IndentingNewLine]", ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", 
            RowBox[{"Length", "[", "y", "]"}]}], "}"}]}], "]"}], "//", 
        "Factor"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Return", "[", 
       RowBox[{"{", 
        RowBox[{"Bp", ",", "yp"}], "}"}], "]"}], ";"}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.926647301461121*^9, 3.926647690769335*^9}, {
  3.928038227327625*^9, 3.928038233962109*^9}, {3.960591601954755*^9, 
