                  RowBox[{
                   RowBox[{"8", "-", "i"}], ",", "7"}], "]"}], ",", 
                 RowBox[{"8", "-", "i"}]}], "]"}]}], "]"}]}], "}"}]}], 
          ")"}]}], "]"}]}]}], "]"}], "/.", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"a", "[", 
