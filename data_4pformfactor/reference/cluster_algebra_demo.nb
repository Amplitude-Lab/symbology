 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "FBCombineR", "]"}], "=", 
   RowBox[{"{", 
    RowBox[{"deBug", "->", "False"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"FBCombineR", "[", 
    RowBox[{"exp_", ",", 
     RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "tem", ",", "flist", ",", "pow", ",", "subset", ",", "coef", ",", "sim",
        ",", 
       RowBox[{"result", "=", "0"}], ",", 
       RowBox[{"flag", "=", "1"}], ",", 
       RowBox[{"k", "=", "1"}]}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"tem", "=", 
       RowBox[{"exp", "//", "Expand"}]}], 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"//", "MTExpand"}], "//", "Expand"}], "*)"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Head", "[", "tem", "]"}], "=!=", "Plus"}], ",", 
        RowBox[{"Return", "[", "tem", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"flist", "=", 
       RowBox[{
        RowBox[{"Cases", "[", 
         RowBox[{"tem", ",", 
          RowBox[{"FB", "[", "__", "]"}], ",", "Infinity"}], "]"}], "//", 
        "DeleteDuplicates"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"pow", "=", 
       RowBox[{"Count", "[", 
        RowBox[{
         RowBox[{"tem", "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", 
         RowBox[{"FB", "[", "__", "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"OptionValue", "[", "deBug", "]"}], ",", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<pow \>\"", ",", "pow"}], "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"pow", "<=", "2"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"pow", "==", "1"}], ",", 
           RowBox[{"Return", "[", "exp", "]"}]}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"sim", "=", 
          RowBox[{"CombinePair", "[", "tem", "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"OptionValue", "[", "deBug", "]"}], ",", 
           RowBox[{"Print", "[", 
            RowBox[{"\"\<sim: \>\"", ",", "sim"}], "]"}]}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"Return", "[", 
          RowBox[{
           RowBox[{"sim", "[", 
            RowBox[{"[", "2", "]"}], "]"}], "+", 
           RowBox[{"sim", "[", 
            RowBox[{"[", "3", "]"}], "]"}]}], "]"}]}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"While", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"tem", "=!=", "0"}], "&&", 
         RowBox[{"flag", "==", "1"}], "&&", 
         RowBox[{"k", "<", "10"}]}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"OptionValue", "[", "deBug", "]"}], ",", 
           RowBox[{"Print", "[", 
            RowBox[{"\"\<tem: \>\"", ",", "tem"}], "]"}]}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"flist", "=", 
          RowBox[{
           RowBox[{"Cases", "[", 
            RowBox[{"tem", ",", 
             RowBox[{"FB", "[", "__", "]"}], ",", "Infinity"}], "]"}], "//", 
           "DeleteDuplicates"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"subset", "=", 
          RowBox[{"Times", "@@@", 
           RowBox[{"(", 
            RowBox[{"Subsets", "[", 
             RowBox[{"flist", ",", 
              RowBox[{"{", 
               RowBox[{"pow", "-", "2"}], "}"}]}], "]"}], ")"}]}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"coef", "=", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"Coefficient", "[", 
              RowBox[{"tem", ",", "#"}], "]"}], "&"}], "/@", "subset"}], "//",
            "Factor"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"OptionValue", "[", "deBug", "]"}], ",", 
           RowBox[{
            RowBox[{"Print", "[", 
             RowBox[{"\"\<subset: \>\"", ",", "subset"}], "]"}], ";", 
            RowBox[{"Print", "[", 
             RowBox[{"\"\<coef: \>\"", ",", "coef"}], "]"}]}]}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"flag", "=", "0"}], ";", "\[IndentingNewLine]", 
         RowBox[{"Do", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"sim", "=", 
             RowBox[{"CombinePair", "[", 
              RowBox[{"coef", "[", 
               RowBox[{"[", "j", "]"}], "]"}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"OptionValue", "[", "deBug", "]"}], ",", 
              RowBox[{"Print", "[", 
               RowBox[{"\"\<sim: \>\"", ",", "sim"}], "]"}]}], "]"}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"sim", "[", 
                RowBox[{"[", "1", "]"}], "]"}], "==", "0"}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{"Continue", "[", "]"}], ",", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"result", "=", 
                RowBox[{"result", "+", 
                 RowBox[{
                  RowBox[{"subset", "[", 
                   RowBox[{"[", "j", "]"}], "]"}], "*", 
                  RowBox[{"sim", "[", 
                   RowBox[{"[", "2", "]"}], "]"}]}]}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"tem", "=", 
                RowBox[{
                 RowBox[{"tem", "-", 
                  RowBox[{
                   RowBox[{"coef", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], "*", 
                   RowBox[{"subset", "[", 
                    RowBox[{"[", "j", "]"}], "]"}]}], "+", 
                  RowBox[{
                   RowBox[{"subset", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], "*", 
                   RowBox[{"sim", "[", 
                    RowBox[{"[", "3", "]"}], "]"}]}]}], "//", "Expand"}]}], 
               ";", "\[IndentingNewLine]", 
               RowBox[{"flag", "=", "1"}], ";", "\[IndentingNewLine]", 
               RowBox[{"Break", "[", "]"}]}]}], "]"}], ";"}], 
           "\[IndentingNewLine]", ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", "1", ",", 
             RowBox[{"Length", "[", "coef", "]"}]}], "}"}]}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"OptionValue", "[", "deBug", "]"}], ",", 
           RowBox[{
            RowBox[{"Print", "[", 
             RowBox[{"\"\<result: \>\"", ",", "result"}], "]"}], ";", 
            RowBox[{"Print", "[", 
             RowBox[{"\"\<tem: \>\"", ",", "tem"}], "]"}]}]}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"k", "=", 
          RowBox[{"k", "+", "1"}]}], ";"}]}], "\[IndentingNewLine]", "]"}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"Return", "[", 
       RowBox[{
        RowBox[{"tem", "+", "result"}], "//", "Factor"}], "]"}], ";"}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",
