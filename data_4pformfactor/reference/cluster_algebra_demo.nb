              RowBox[{"FB", "[", 
               RowBox[{"a", ",", 
                RowBox[{"BiTw", "[", 
                 RowBox[{"b", ",", "c"}], "]"}], ",", 
                RowBox[{"BiTw", "[", 
                 RowBox[{"d", ",", "e"}], "]"}], ",", 
