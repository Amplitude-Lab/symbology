Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "MutateGraph", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"MutateGraph", "::", "usage"}], "=", 
   "\"\<MutateGraph[g,v] mutate the graph at the vertex v\>\""}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"MutateGraph", "[", 
    RowBox[{"g_", ",", "v_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "sub", ",", "in", ",", "out", ",", "ng", ",", "subed", ",", "ced", ",", 
       "ned", ",", "n"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"sub", "=", 
       RowBox[{"NeighborhoodGraph", "[", 
        RowBox[{"g", ",", 
         RowBox[{"{", "v", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"subed", "=", 
       RowBox[{"EdgeList", "[", "sub", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"ng", "=", 
       RowBox[{"EdgeDelete", "[", 
        RowBox[{"g", ",", "subed"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"out", "=", 
       RowBox[{
        RowBox[{"EdgeList", "[", 
         RowBox[{"sub", ",", 
          RowBox[{"v", "\[DirectedEdge]", "_"}]}], "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ";", 
      RowBox[{"(*", 
       RowBox[{"vertex", " ", "out"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"in", "=", 
       RowBox[{
        RowBox[{"EdgeList", "[", 
         RowBox[{"sub", ",", 
          RowBox[{"_", "\[DirectedEdge]", "v"}]}], "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ";", 
      RowBox[{"(*", 
       RowBox[{"vertex", " ", "in"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"ned", "=", 
       RowBox[{"DirectedEdge", "@@@", 
        RowBox[{"Tuples", "[", 
         RowBox[{"{", 
          RowBox[{"out", ",", "in"}], "}"}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"ced", "=", "ned"}], ";", "\[IndentingNewLine]", 
      RowBox[{"ned", "=", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"ConstantArray", "[", 
              RowBox[{"#", ",", 
               RowBox[{"Count", "[", 
                RowBox[{"ced", ",", "#"}], "]"}]}], "]"}], "&"}], "/@", 
            RowBox[{"Complement", "[", 
             RowBox[{"ced", ",", "subed"}], "]"}]}], ")"}], "//", "Flatten"}],
          ",", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"ConstantArray", "[", 
              RowBox[{"#", ",", 
               RowBox[{
                RowBox[{"Count", "[", 
                 RowBox[{"ced", ",", "#"}], "]"}], "-", 
                RowBox[{"Min", "[", 
                 RowBox[{
                  RowBox[{"Count", "[", 
                   RowBox[{"subed", ",", "#"}], "]"}], ",", 
                  RowBox[{"Count", "[", 
                   RowBox[{"ced", ",", "#"}], "]"}]}], "]"}]}]}], "]"}], 
             "&"}], "/@", " ", 
            RowBox[{"Intersection", "[", 
             RowBox[{"subed", ",", "ced"}], "]"}]}], ")"}], "//", 
          "Flatten"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"Echo", "[", 
         RowBox[{"ced", ",", "\"\<ced\>\""}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Echo", "[", 
         RowBox[{"ned", ",", "\"\<ned\>\""}], "]"}], ";"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"subed", "=", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"ConstantArray", "[", 
              RowBox[{"#", ",", 
               RowBox[{"Count", "[", 
                RowBox[{"subed", ",", "#"}], "]"}]}], "]"}], "&"}], "/@", 
            RowBox[{"Complement", "[", 
             RowBox[{"subed", ",", 
              RowBox[{"Join", "[", 
               RowBox[{"ced", ",", 
                RowBox[{
                 RowBox[{
                  RowBox[{"DirectedEdge", "[", 
                   RowBox[{"v", ",", "#"}], "]"}], "&"}], "/@", "out"}], ",", 
                
                RowBox[{
                 RowBox[{
                  RowBox[{"DirectedEdge", "[", 
                   RowBox[{"#", ",", "v"}], "]"}], "&"}], "/@", "in"}]}], 
               "]"}]}], "]"}]}], ")"}], "//", "Flatten"}], ",", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"ConstantArray", "[", 
              RowBox[{"#", ",", 
               RowBox[{
                RowBox[{"Count", "[", 
                 RowBox[{"subed", ",", "#"}], "]"}], "-", 
                RowBox[{"Min", "[", 
                 RowBox[{
                  RowBox[{"Count", "[", 
                   RowBox[{"subed", ",", "#"}], "]"}], ",", 
                  RowBox[{"Count", "[", 
                   RowBox[{"ced", ",", "#"}], "]"}]}], "]"}]}]}], "]"}], 
             "&"}], "/@", " ", 
            RowBox[{"Intersection", "[", 
             RowBox[{"subed", ",", "ced"}], "]"}]}], ")"}], "//", 
          "Flatten"}]}], "]"}]}], ";", 
      RowBox[{"(*", 
       RowBox[{"edges", " ", "not", " ", "mutated"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"Return", "[", 
       RowBox[{"EdgeAdd", "[", 
        RowBox[{"ng", ",", 
         RowBox[{"Join", "[", 
          RowBox[{"subed", ",", 
           RowBox[{"Reverse", "/@", 
            RowBox[{"Join", "[", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"DirectedEdge", "[", 
                 RowBox[{"#", ",", "v"}], "]"}], "&"}], "/@", "in"}], ",", 
              RowBox[{
               RowBox[{
                RowBox[{"DirectedEdge", "[", 
                 RowBox[{"v", ",", "#"}], "]"}], "&"}], "/@", "out"}], ",", 
              "ned"}], "]"}]}]}], "]"}]}], "]"}], "]"}], ";"}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.891819426897171*^9, 3.89181943024371*^9}, {
   3.891823574297639*^9, 3.891823617943605*^9}, {3.891823904305662*^9, 
