Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "ReconstructExp", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ReconstructExp", "::", "usage"}], "=", 
   "\"\<Re-express the expression using Mandelstam variables.\>\""}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "ReconstructExp", "]"}], "=", 
   RowBox[{"{", 
    RowBox[{"deBug", "->", "False"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ReconstructExp", "[", 
    RowBox[{"exp_", ",", "basis_", ",", 
     RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "start", ",", "tem", ",", "pow", ",", "tem1", ",", "fac", ",", "list", 
       ",", "tuples", ",", "tem2", ",", "zs"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"start", "=", 
       RowBox[{"SessionTime", "[", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"tem", "=", 
       RowBox[{
        RowBox[{"exp", "//", "MTExpand"}], "//", "Expand"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"pow", "=", 
       RowBox[{"Exponent", "[", 
        RowBox[{
         RowBox[{"tem", "/.", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"FB", "[", "a__", "]"}], ":>", 
            RowBox[{"M", "*", 
             RowBox[{"FB", "[", "a", "]"}]}]}], "}"}]}], ",", "M"}], "]"}]}], 
      ";", 
      RowBox[{"(*", 
       RowBox[{"count", " ", "the", " ", "dimension"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"OptionValue", "[", "deBug", "]"}], ",", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<pow: \>\"", ",", "pow"}], "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Head", "[", "exp", "]"}], "===", "Plus"}], ",", 
        RowBox[{"tem1", "=", 
         RowBox[{"tem", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], ",", 
        RowBox[{"tem1", "=", "tem"}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"fac", "=", 
       RowBox[{"FactorList", "[", "tem1", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"list", "=", 
       RowBox[{
        RowBox[{"Reap", "[", "\[IndentingNewLine]", 
         RowBox[{"Do", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Head", "[", 
               RowBox[{"fac", "[", 
                RowBox[{"[", 
                 RowBox[{"i", ",", "1"}], "]"}], "]"}], "]"}], "===", "FB"}], 
             ",", 
             RowBox[{"Do", "[", 
              RowBox[{
               RowBox[{"Sow", "[", 
                RowBox[{"List", "@@", 
                 RowBox[{"fac", "[", 
                  RowBox[{"[", 
                   RowBox[{"i", ",", "1"}], "]"}], "]"}]}], "]"}], ",", 
               RowBox[{"{", 
                RowBox[{"j", ",", "1", ",", 
                 RowBox[{"fac", "[", 
                  RowBox[{"[", 
                   RowBox[{"i", ",", "2"}], "]"}], "]"}]}], "}"}]}], "]"}]}], 
            "]"}], "\[IndentingNewLine]", ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "1", ",", 
             RowBox[{"Length", "[", "fac", "]"}]}], "}"}]}], "]"}], 
         "\[IndentingNewLine]", "]"}], "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"list", "=!=", 
         RowBox[{"{", "}"}]}], ",", 
        RowBox[{"list", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"list", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "//", "Flatten"}], "//", 
          "Sort"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"OptionValue", "[", "deBug", "]"}], ",", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<list: \>\"", ",", "list"}], "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"tem1", "=", 
       RowBox[{"DeleteCases", "[", 
        RowBox[{
         RowBox[{"Identity", "@@@", 
          RowBox[{"(", 
           RowBox[{"Abs", "/@", "basis"}], ")"}]}], ",", 
         RowBox[{"_", "?", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Not", "@", 
             RowBox[{"ContainsAll", "[", 
              RowBox[{"list", ",", 
               RowBox[{"List", "@@", "#"}]}], "]"}]}], "&"}], ")"}]}]}], 
        "]"}]}], ";", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{
        "remove", " ", "terms", " ", "that", " ", "cannot", " ", "appear", 
         " ", "in", " ", "the", " ", "expression"}], ",", " ", 
        RowBox[{
        "the", " ", "minus", " ", "sign", " ", "before", " ", "each", " ", 
         "term", " ", "is", " ", "removed"}]}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"OptionValue", "[", "deBug", "]"}], ",", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<basis: \>\"", ",", "tem1"}], "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"tuples", "=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"Sort", "/@", 
          RowBox[{"Tuples", "[", 
           RowBox[{"tem1", ",", "pow"}], "]"}]}], ")"}], "//", 
        "DeleteDuplicates"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"tem1", "=", 
       RowBox[{
        RowBox[{"Reap", "[", "\[IndentingNewLine]", 
         RowBox[{"Do", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"List", "@@@", 
                   RowBox[{"tuples", "[", 
                    RowBox[{"[", "i", "]"}], "]"}]}], ")"}], "//", 
                 "Flatten"}], "//", "Sort"}], ")"}], "=!=", "list"}], ",", 
             RowBox[{"Continue", "[", "]"}], ",", 
             RowBox[{"Sow", "[", 
              RowBox[{"Times", "@@", 
               RowBox[{"tuples", "[", 
                RowBox[{"[", "i", "]"}], "]"}]}], "]"}]}], "]"}], 
           "\[IndentingNewLine]", ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "1", ",", 
             RowBox[{"Length", "[", "tuples", "]"}]}], "}"}]}], "]"}], 
         "\[IndentingNewLine]", "]"}], "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"tem1", "===", 
         RowBox[{"{", "}"}]}], ",", 
        RowBox[{
         RowBox[{
         "Print", "[", "\"\<no such expressions can be constructed!\>\"", 
          "]"}], ";", 
         RowBox[{"Return", "[", "$Failed", "]"}]}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"tem1", "=", 
       RowBox[{"tem1", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"OptionValue", "[", "deBug", "]"}], ",", 
        RowBox[{
         RowBox[{"Print", "[", 
          RowBox[{"\"\<length of ansatz: \>\"", ",", 
           RowBox[{"Length", "[", "tem1", "]"}]}], "]"}], ";", 
         RowBox[{"Print", "[", 
          RowBox[{"\"\<session time: \>\"", ",", 
           RowBox[{
            RowBox[{"SessionTime", "[", "]"}], "-", "start"}]}], "]"}]}]}], 
       "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"OptionValue", "[", "deBug", "]"}], ",", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", "tem1", "]"}], "<", "100"}], ",", 
          RowBox[{"Print", "[", 
           RowBox[{"\"\<tem1 \>\"", ",", "tem1"}], "]"}], ",", 
          RowBox[{"Print", "[", 
           RowBox[{"\"\<examples: \>\"", ",", 
            RowBox[{"Take", "[", 
             RowBox[{"tem1", ",", 
              RowBox[{"UpTo", "[", "10", "]"}]}], "]"}]}], "]"}]}], "]"}]}], 
       "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"tem2", "=", 
       RowBox[{
        RowBox[{"Reap", "[", 
         RowBox[{"(*", 
          RowBox[{
          "generate", " ", "sufficient", " ", "sets", " ", "of", " ", 
           "numbers", " ", "to", " ", "solve", " ", "the", " ", 
           "coefficients"}], "*)"}], "\[IndentingNewLine]", 
         RowBox[{"Monitor", "[", 
          RowBox[{
           RowBox[{"Do", "[", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{
              RowBox[{"zs", "=", 
               RowBox[{"RandomZs", "[", "$NUM", "]"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"Sow", "[", 
               RowBox[{
                RowBox[{"tem1", "//", 
                 RowBox[{
                  RowBox[{"FBToNum", "[", 
                   RowBox[{"#", ",", 
                    RowBox[{"\"\<explicitM\>\"", "->", "zs"}]}], "]"}], 
                  "&"}]}], ",", "1"}], "]"}], ";", "\[IndentingNewLine]", 
              RowBox[{"Sow", "[", 
               RowBox[{
                RowBox[{"tem", "//", 
                 RowBox[{
                  RowBox[{"FBToNum", "[", 
                   RowBox[{"#", ",", 
                    RowBox[{"\"\<explicitM\>\"", "->", "zs"}]}], "]"}], 
                  "&"}]}], ",", "2"}], "]"}], ";"}], "\[IndentingNewLine]", 
             ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", "1", ",", 
               RowBox[{"Length", "[", "tem1", "]"}]}], "}"}]}], "]"}], ",", 
           RowBox[{"Refresh", "[", 
            RowBox[{"i", ",", 
             RowBox[{"UpdateInterval", "\[Rule]", "1"}], ",", 
             RowBox[{"TrackedSymbols", "\[Rule]", 
              RowBox[{"{", "}"}]}]}], "]"}]}], "]"}], "\[IndentingNewLine]", 
         "]"}], "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"OptionValue", "[", "deBug", "]"}], ",", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<session time: \>\"", ",", 
          RowBox[{
           RowBox[{"SessionTime", "[", "]"}], "-", "start"}]}], "]"}]}], 
       "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Return", "[", 
       RowBox[{
        RowBox[{"LinearSolve", "[", 
         RowBox[{
          RowBox[{"tem2", "[", 
           RowBox[{"[", "1", "]"}], "]"}], ",", 
          RowBox[{"tem2", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}], "]"}], ".", "tem1"}], "]"}], 
      ";"}]}], "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",
