Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "CreateQuiver", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"CreateQuiver", "::", "usage"}], "=", 
   "\"\<CreateQuiver[B] creates a quiver graph from extended exchange matrix \
B\>\""}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "CreateQuiver", "]"}], "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"GraphLayout", "->", "\"\<SpringElectricalEmbedding\>\""}], ",", 
     
     RowBox[{"\"\<outputlevel\>\"", "->", "1"}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"CreateQuiver", "[", 
    RowBox[{"B_", ",", 
     RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"l", ",", "cl", ",", "g", ",", "vlabel"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"l", "=", 
       RowBox[{"Length", "[", "B", "]"}]}], ";", 
      RowBox[{"(*", 
       RowBox[{
       "n", " ", "rows", " ", "correspond", " ", "to", " ", "n", " ", 
        "vertices"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"cl", "=", 
       RowBox[{"Length", "[", 
        RowBox[{"B", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "]"}]}], ";", 
      RowBox[{"(*", 
       RowBox[{
       "n", " ", "columns", " ", "correspond", " ", "to", " ", "n", " ", 
        "mutable", " ", "vertices"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"OptionValue", "[", "\"\<outputlevel\>\"", "]"}], ",", 
        RowBox[{"Print", "[", 
         RowBox[{"cl", ",", "\"\< mutable variables; \>\"", ",", 
          RowBox[{"l", "-", "cl"}], ",", "\"\< frozen variables.\>\""}], 
         "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"g", "=", 
       RowBox[{
        RowBox[{"Reap", "[", 
         RowBox[{"Do", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Do", "[", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"B", "[", 
                 RowBox[{"[", 
                  RowBox[{"i", ",", "j"}], "]"}], "]"}], ">", "0"}], ",", 
               RowBox[{"Sow", "[", 
                RowBox[{"ConstantArray", "[", 
                 RowBox[{
                  RowBox[{"DirectedEdge", "[", 
                   RowBox[{"i", ",", "j"}], "]"}], ",", 
                  RowBox[{"B", "[", 
                   RowBox[{"[", 
                    RowBox[{"i", ",", "j"}], "]"}], "]"}]}], "]"}], "]"}], 
               ",", 
               RowBox[{"Sow", "[", 
                RowBox[{"ConstantArray", "[", 
                 RowBox[{
                  RowBox[{"DirectedEdge", "[", 
                   RowBox[{"j", ",", "i"}], "]"}], ",", 
                  RowBox[{"-", 
                   RowBox[{"B", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ",", "j"}], "]"}], "]"}]}]}], "]"}], "]"}]}],
               "]"}], "\[IndentingNewLine]", ",", 
             RowBox[{"{", 
              RowBox[{"j", ",", 
               RowBox[{"i", "+", "1"}], ",", "cl"}], "}"}]}], "]"}], 
           "\[IndentingNewLine]", ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "1", ",", 
             RowBox[{"Min", "[", 
              RowBox[{"l", ",", "cl"}], "]"}]}], "}"}]}], "]"}], 
         "\[IndentingNewLine]", "]"}], "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"g", "=!=", 
         RowBox[{"{", "}"}]}], ",", 
        RowBox[{"g", "=", 
         RowBox[{
          RowBox[{"g", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "//", "Flatten"}]}], ",", 
        RowBox[{"Return", "[", 
         RowBox[{"{", "}"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"Print", "[", "g", "]"}], ";"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"vlabel", "=", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"#", "->", 
             RowBox[{"Button", "[", 
              RowBox[{"#", ",", 
               RowBox[{"h", "=", 
                RowBox[{"MutateGraph", "[", 
                 RowBox[{"h", ",", "#"}], "]"}]}]}], "]"}]}], ")"}], "&"}], "/@", 
          RowBox[{"Table", "[", 
           RowBox[{"i", ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "1", ",", "cl"}], "}"}]}], "]"}]}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"#", "->", 
             RowBox[{"Button", "[", 
              RowBox[{"#", ",", "Null"}], "]"}]}], ")"}], "&"}], "/@", 
          RowBox[{"Table", "[", 
           RowBox[{"i", ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", 
              RowBox[{"cl", "+", "1"}], ",", "l"}], "}"}]}], "]"}]}]}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Graph", "[", 
       RowBox[{"g", ",", 
        RowBox[{"VertexLabels", "\[Rule]", "vlabel"}], ",", 
        RowBox[{"GraphLayout", "\[Rule]", 
         RowBox[{"OptionValue", "[", "GraphLayout", "]"}]}]}], "]"}]}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.926591459844858*^9, 3.926591476557723*^9}, {
  3.926591805479939*^9, 3.926591865873654*^9}, {3.926592007886098*^9, 
  3.926592118898685*^9}, {3.926592337183329*^9, 3.926592347040843*^9}, {
  3.926592385335437*^9, 3.926592436724108*^9}, {3.926592473099662*^9, 
  3.926592681057995*^9}, {3.926592711663123*^9, 3.926592940299349*^9}, {
  3.926593006581368*^9, 3.926593023113989*^9}, {3.926593136982441*^9, 
  3.926593154873554*^9}, {3.9265931931654463`*^9, 3.926593215015563*^9}, {
  3.92659338861486*^9, 3.926593413280863*^9}, {3.973889061832477*^9, 
  3.973889092872027*^9}, {3.973889140576138*^9, 3.973889154446137*^9}},
 CellLabel->
  "In[341]:=",ExpressionUUID->"0d4d822f-c8a7-4d1d-977c-c8d2039637d0"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "a", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SetAttributes", "[", 
   RowBox[{"a", ",", 
    RowBox[{"{", "Orderless", "}"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ClearAll", "[", "GramM", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"GramM", "::", "err"}], "=", 
   "\"\<The input should be a square matrix.\>\""}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"GramM", "[", "I_", "]"}], ":=", 
   RowBox[{"GramM", "[", 
    RowBox[{"I", ",", "I"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "GramM", "]"}], "=", 
   RowBox[{"{", 
    RowBox[{"\"\<explicitM\>\"", "->", 
     RowBox[{"{", "}"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"GramM", "[", 
    RowBox[{"I_", ",", "J_", ",", 
     RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"r", ",", "c", ",", 
       RowBox[{"rep", "=", 
        RowBox[{"{", "}"}]}]}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"r", "=", 
       RowBox[{"I", "//", "Sort"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"c", "=", 
       RowBox[{"J", "//", "Sort"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", "I", "]"}], "!=", 
         RowBox[{"Length", "[", "J", "]"}]}], ",", 
        RowBox[{
         RowBox[{"Message", "[", 
          RowBox[{"GramM", "::", "err"}], "]"}], ";", 
         RowBox[{"Return", "[", "$Failed", "]"}]}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"OptionValue", "[", "\"\<explicitM\>\"", "]"}], "=!=", 
         RowBox[{"{", "}"}]}], ",", 
        RowBox[{"rep", "=", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"a", "[", 
            RowBox[{"i_", ",", "j_"}], "]"}], ":>", 
           RowBox[{
            RowBox[{"OptionValue", "[", "\"\<explicitM\>\"", "]"}], "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "j"}], "]"}], "]"}]}], "}"}]}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Det", "[", 
       RowBox[{
        RowBox[{"Outer", "[", 
         RowBox[{"a", ",", "r", ",", "c"}], "]"}], "/.", "rep"}], "]"}]}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.927341087057596*^9, 3.927341122422134*^9}, {
  3.92734116294299*^9, 3.927341291058792*^9}, {3.927341488815015*^9, 
  3.927341496451668*^9}, {3.927341796353053*^9, 3.927341808194125*^9}, {
  3.927350117397421*^9, 3.927350138548398*^9}, {3.928037073650975*^9, 
  3.928037206512411*^9}},
