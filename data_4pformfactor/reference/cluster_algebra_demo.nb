Cell["Now we remove the dihedral symmetry", "Text",
 CellChangeTimes->{{3.974978119599983*^9, 
  3.974978132117734*^9}},ExpressionUUID->"1977f821-6942-40d4-a7ea-\
63d6108030c9"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"adjpair3s", "=", 
   RowBox[{"{", 
    RowBox[{"adjpair3c", "[", 
     RowBox[{"[", "1", "]"}], "]"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"temp", "=", 
   RowBox[{
    RowBox[{"Complement", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"Sort", "/@", "adjpair3c"}], ")"}], "//", "Sort"}], ",", 
      RowBox[{
       RowBox[{"Sort", "/@", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"Join", "[", 
            RowBox[{"#", ",", 
             RowBox[{"#", "/.", "fliprep"}]}], "]"}], "&"}], "[", 
          RowBox[{"Join", "@@", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"adjpair3s", "/.", 
              RowBox[{"cycrep", "[", 
               RowBox[{"[", "i", "]"}], "]"}]}], ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", "1", ",", "7"}], "}"}]}], "]"}]}], "]"}], 
         ")"}]}], "//", "Sort"}]}], "]"}], "//", "Sort"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"kk", "=", "1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"While", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"temp", "=!=", 
      RowBox[{"{", "}"}]}], "&&", 
     RowBox[{"kk", "<", "1000"}]}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"adjpair3s", "=", 
      RowBox[{"Join", "[", 
       RowBox[{"adjpair3s", ",", 
        RowBox[{"{", 
         RowBox[{"temp", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"temp", "=", 
      RowBox[{
       RowBox[{"Complement", "[", 
        RowBox[{"temp", ",", 
         RowBox[{
          RowBox[{
           RowBox[{"Sort", "/@", 
            RowBox[{"Join", "[", 
             RowBox[{"#", ",", 
              RowBox[{"#", "/.", "fliprep"}]}], "]"}]}], "&"}], "[", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"Join", "@@", 
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"temp", "[", 
                  RowBox[{"[", "1", "]"}], "]"}], "}"}], "/.", 
                RowBox[{"cycrep", "[", 
                 RowBox[{"[", "i", "]"}], "]"}]}], ",", 
               RowBox[{"{", 
                RowBox[{"i", ",", "1", ",", "7"}], "}"}]}], "]"}]}], ")"}], "//",
            "Sort"}], "]"}]}], "]"}], "//", "Sort"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"kk", "=", 
      RowBox[{"kk", "+", "1"}]}], ";"}]}], "\[IndentingNewLine]", "]"}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.974978098316354*^9, 3.974978116776005*^9}, {
   3.974978158255683*^9, 3.974978281674244*^9}, {3.9749783258968687`*^9, 
   3.974978490204466*^9}, 3.974978520781577*^9, {3.974978558385976*^9, 
   3.974978564592765*^9}, {3.974978707146367*^9, 3.974978715624131*^9}, {
   3.9749790962880993`*^9, 3.974979145359972*^9}, {3.974979175886888*^9, 
   3.974979218185885*^9}, {3.974979345304802*^9, 3.974979356253975*^9}, {
   3.974979492104759*^9, 3.974979493097619*^9}},
 CellLabel->
  "In[305]:=",ExpressionUUID->"e469ebaf-9775-40b1-a1a9-58155b2b3201"],

