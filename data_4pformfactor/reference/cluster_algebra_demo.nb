                  RowBox[{
                   RowBox[{"8", "-", "i"}], ",", "7"}], "]"}], ",", 
                 RowBox[{"8", "-", "i"}]}], "]"}]}], "]"}]}], "}"}]}], 
          ")"}]}], "]"}]}], ",", 
      RowBox[{"Thread", "@", 
       RowBox[{"Rule", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"a", "[", 
            RowBox[{"3", ",", "#"}], "]"}], "&"}], "/@", 
          RowBox[{"Range", "[", "7", "]"}]}], ",", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"a", "[", 
              RowBox[{"2", ",", "#"}], "]"}], "&"}], "/@", 
            RowBox[{"Range", "[", "7", "]"}]}], "/.", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"a", "[", 
              RowBox[{"2", ",", "i_"}], "]"}], ":>", 
             RowBox[{"a", "[", 
              RowBox[{"2", ",", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"8", "-", "i"}], ">", "7"}], ",", 
