 RowBox[{
  RowBox[{"ClearAll", "[", "Somos4", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Somos4", "[", "0", "]"}], "=", "1"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Somos4", "[", "1", "]"}], "=", "1"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Somos4", "[", "2", "]"}], "=", "1"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Somos4", "[", "3", "]"}], "=", "1"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Somos4", "[", 
    RowBox[{"n_", "/;", 
     RowBox[{"(", 
      RowBox[{"n", ">", "0"}], ")"}]}], "]"}], ":=", 
   RowBox[{
    RowBox[{"Somos4", "[", "n", "]"}], "=", 
    RowBox[{
     RowBox[{"(", 
