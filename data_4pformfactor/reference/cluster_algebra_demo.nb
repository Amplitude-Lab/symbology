  "In[261]:=",ExpressionUUID->"8c47ec4a-07f1-4c75-b6f6-5bfde9fa9e14"],

Cell[BoxData[
 RowBox[{
  RowBox[{"fliprep", "=", 
   RowBox[{
    RowBox[{"Join", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Thread", "@", 
          RowBox[{"Rule", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"a", "[", 
               RowBox[{"k", ",", "#"}], "]"}], "&"}], "/@", 
