     RowBox[{
      RowBox[{"Keys", "[", "rewrite", "]"}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"Values", "[", "rewrite", "]"}], "/.", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"ab", "[", 
