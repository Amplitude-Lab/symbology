      RowBox[{"fB", "[", 
       RowBox[{
        RowBox[{"{", "a", "}"}], ",", 
        RowBox[{"\"\<explicitM\>\"", "->", 
         RowBox[{"OptionValue", "[", "\"\<explicitM\>\"", "]"}]}]}], "]"}]}], 
     "}"}]}]}], ";"}]}], "Input",
