Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "MutateBR", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"MutateBR", "::", "usage"}], "=", 
   "\"\<MutateB[B,x,k] mutate the exchange matrix B and the corresponding \
cluster variables x in direction k\>\""}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "MutateBR", "]"}], "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\"\<rep\>\"", "->", 
      RowBox[{"{", "}"}]}], ",", 
     RowBox[{"\"\<repinv\>\"", "->", 
      RowBox[{"{", "}"}]}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"MutateBR", "[", 
    RowBox[{"B_", ",", "x_", ",", "k_", ",", 
     RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"Bp", ",", "xp", ",", "l", ",", "tem", ",", "tem1"}], "}"}], 
     ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"l", "=", 
       RowBox[{"B", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "k"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"xp", "=", "x"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Bp", "=", 
       RowBox[{"Table", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"i", "==", "k"}], "||", 
            RowBox[{"j", "==", "k"}]}], ",", 
           RowBox[{"-", 
            RowBox[{"B", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", "j"}], "]"}], "]"}]}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"B", "[", 
                RowBox[{"[", 
                 RowBox[{"i", ",", "k"}], "]"}], "]"}], ">", "0"}], "&&", 
              RowBox[{
               RowBox[{"B", "[", 
                RowBox[{"[", 
                 RowBox[{"k", ",", "j"}], "]"}], "]"}], ">", "0"}]}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"B", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", "j"}], "]"}], "]"}], "+", 
              RowBox[{
               RowBox[{"B", "[", 
                RowBox[{"[", 
                 RowBox[{"i", ",", "k"}], "]"}], "]"}], "*", 
               RowBox[{"B", "[", 
                RowBox[{"[", 
                 RowBox[{"k", ",", "j"}], "]"}], "]"}]}]}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"B", "[", 
                  RowBox[{"[", 
                   RowBox[{"i", ",", "k"}], "]"}], "]"}], "<", "0"}], "&&", 
                RowBox[{
                 RowBox[{"B", "[", 
                  RowBox[{"[", 
                   RowBox[{"k", ",", "j"}], "]"}], "]"}], "<", "0"}]}], ",", 
               RowBox[{
                RowBox[{"B", "[", 
                 RowBox[{"[", 
                  RowBox[{"i", ",", "j"}], "]"}], "]"}], "-", 
                RowBox[{
                 RowBox[{"B", "[", 
                  RowBox[{"[", 
                   RowBox[{"i", ",", "k"}], "]"}], "]"}], "*", 
                 RowBox[{"B", "[", 
                  RowBox[{"[", 
                   RowBox[{"k", ",", "j"}], "]"}], "]"}]}]}], ",", 
               RowBox[{"B", "[", 
                RowBox[{"[", 
                 RowBox[{"i", ",", "j"}], "]"}], "]"}]}], "]"}]}], 
            "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", "]"}], 
         "\[IndentingNewLine]", ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", 
           RowBox[{"Length", "[", "B", "]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", "1", ",", 
           RowBox[{"Length", "[", 
            RowBox[{"B", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "]"}]}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"tem", "=", 
       RowBox[{
        RowBox[{"Join", "[", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"l", "[", 
                RowBox[{"[", "i", "]"}], "]"}], ">", "0"}], ",", 
              RowBox[{"{", 
               RowBox[{"1", ",", 
                RowBox[{"Power", "[", 
                 RowBox[{
                  RowBox[{"x", "[", 
                   RowBox[{"[", "i", "]"}], "]"}], ",", 
                  RowBox[{"l", "[", 
                   RowBox[{"[", "i", "]"}], "]"}]}], "]"}]}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"2", ",", 
                RowBox[{"Power", "[", 
                 RowBox[{
                  RowBox[{"x", "[", 
                   RowBox[{"[", "i", "]"}], "]"}], ",", 
                  RowBox[{"-", 
                   RowBox[{"l", "[", 
                    RowBox[{"[", "i", "]"}], "]"}]}]}], "]"}]}], "}"}]}], 
             "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "1", ",", 
              RowBox[{"Length", "[", "l", "]"}]}], "}"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"1", ",", "1"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"2", ",", "1"}], "}"}]}], "}"}]}], "]"}], "//", 
        RowBox[{
         RowBox[{"GatherBy", "[", 
          RowBox[{"#", ",", "First"}], "]"}], "&"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"tem1", "=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"Times", "@@", 
            RowBox[{"tem", "[", 
             RowBox[{"[", 
              RowBox[{"1", ",", "All", ",", "2"}], "]"}], "]"}]}], ")"}], "+", 
          RowBox[{"(", 
           RowBox[{"Times", "@@", 
            RowBox[{"tem", "[", 
             RowBox[{"[", 
              RowBox[{"2", ",", "All", ",", "2"}], "]"}], "]"}]}], ")"}]}], 
         ")"}], "/", 
        RowBox[{"xp", "[", 
         RowBox[{"[", "k", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"xp", "[", 
        RowBox[{"[", "k", "]"}], "]"}], "=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"tem1", "/.", 
            RowBox[{"OptionValue", "[", "\"\<rep\>\"", "]"}]}], ")"}], "//", 
          "Factor"}], ")"}], "/.", 
        RowBox[{"OptionValue", "[", "\"\<repinv\>\"", "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Return", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"Bp", ",", "xp"}], "}"}], ",", 
         RowBox[{"Numerator", "[", 
          RowBox[{"Together", "[", 
           RowBox[{
            RowBox[{"xp", "[", 
             RowBox[{"[", "k", "]"}], "]"}], "-", "tem1"}], "]"}], "]"}]}], 
        RowBox[{"(*", 
         RowBox[{"the", " ", "exchange", " ", "relation", " ", "used"}], 
         "*)"}], "}"}], "]"}], ";"}]}], "\[IndentingNewLine]", "]"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.9666641449756947`*^9, 3.966664274175721*^9}, {
  3.966664328810746*^9, 3.966664342933284*^9}, {3.966664798616973*^9, 
  3.966664806337448*^9}},
 CellLabel->"In[98]:=",ExpressionUUID->"9d5a6f53-c3c4-497e-942b-a86d4b796f09"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "BFSExplore", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"BFSExplore", "[", 
    RowBox[{"initialSeed_", ",", "rep_", ",", "repinv_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "queue", ",", "seen", ",", "current", ",", "mutated", ",", "clust", ",",
        "exr", ",", 
       RowBox[{"kk", "=", "1"}], ",", "graph", ",", "graphv", ",", "exm"}], 
      "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"queue", "=", 
       RowBox[{"{", "initialSeed", "}"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"seen", "=", 
       RowBox[{"<|", "|>"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"exr", "=", 
       RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"graph", "=", 
       RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"graphv", "=", 
       RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"exm", "=", 
       RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"While", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "queue", "]"}], ">", "0"}], "&&", 
         RowBox[{"kk", "<", "10000"}]}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"current", "=", 
          RowBox[{"First", "[", "queue", "]"}]}], ";", "\[IndentingNewLine]", 
         
         RowBox[{"queue", "=", 
          RowBox[{"Rest", "[", "queue", "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"clust", "=", 
          RowBox[{"Sort", "[", 
           RowBox[{"current", "[", "\"\<xv\>\"", "]"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"!", 
            RowBox[{"KeyExistsQ", "[", 
             RowBox[{"seen", ",", "clust"}], "]"}]}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{
             RowBox[{"seen", "[", "clust", "]"}], "=", 
             RowBox[{"current", "[", "\"\<xv\>\"", "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"Do", "[", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{
               RowBox[{"mutated", "=", 
                RowBox[{"MutateBR", "[", 
                 RowBox[{
                  RowBox[{"current", "[", "\"\<ex\>\"", "]"}], ",", 
                  RowBox[{"current", "[", "\"\<xv\>\"", "]"}], ",", "k", ",", 
                  
                  RowBox[{"\"\<rep\>\"", "->", "rep"}], ",", 
                  RowBox[{"\"\<repinv\>\"", "->", "repinv"}]}], "]"}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"AppendTo", "[", 
                RowBox[{"queue", ",", 
                 RowBox[{"Association", "[", 
                  RowBox[{"Thread", "@", 
                   RowBox[{"Rule", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"\"\<ex\>\"", ",", "\"\<xv\>\""}], "}"}], ",", 
                    RowBox[{"mutated", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}], "]"}]}], "]"}],
                ";", 
               RowBox[{"(*", 
                RowBox[{"new", " ", "cluster"}], "*)"}], 
               "\[IndentingNewLine]", 
               RowBox[{"AppendTo", "[", 
                RowBox[{"exr", ",", 
                 RowBox[{"mutated", "[", 
                  RowBox[{"[", "2", "]"}], "]"}]}], "]"}], 
               RowBox[{"(*", 
                RowBox[{
                "the", " ", "exchange", " ", "relation", " ", "used", " ", 
                 "to", " ", "obtain", " ", "the", " ", "new", " ", 
                 "cluster"}], "*)"}], ";", "\[IndentingNewLine]", 
               RowBox[{"AppendTo", "[", 
                RowBox[{"graph", ",", 
                 RowBox[{"UndirectedEdge", "[", 
                  RowBox[{
                   RowBox[{"Sort", "[", 
                    RowBox[{"current", "[", "\"\<xv\>\"", "]"}], "]"}], ",", 
                   RowBox[{"Sort", "[", 
                    RowBox[{"mutated", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ",", "2"}], "]"}], "]"}], "]"}]}], "]"}]}], 
                "]"}], 
               RowBox[{"(*", 
                RowBox[{
                "record", " ", "the", " ", "relations", " ", "between", " ", 
                 "two", " ", "clusters", " ", "in", " ", "graph"}], "*)"}], 
               ";", "\[IndentingNewLine]", 
               RowBox[{"AppendTo", "[", 
                RowBox[{"exm", ",", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"current", "[", "\"\<ex\>\"", "]"}], ",", 
                   RowBox[{"current", "[", "\"\<xv\>\"", "]"}]}], "}"}]}], 
                "]"}], 
               RowBox[{"(*", 
                RowBox[{
                "record", " ", "the", " ", "relations", " ", "between", " ", 
                 "two", " ", "clusters", " ", "in", " ", "graph"}], "*)"}], 
               ";", "\[IndentingNewLine]", 
               RowBox[{"graphv", "=", 
                RowBox[{"Join", "[", 
                 RowBox[{"graphv", ",", 
                  RowBox[{
                   RowBox[{"Thread", "@", 
                    RowBox[{"UndirectedEdge", "[", 
                    RowBox[{
                    RowBox[{"current", "[", "\"\<xv\>\"", "]"}], ",", 
                    RowBox[{"mutated", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ",", "2"}], "]"}], "]"}]}], "]"}]}], "//", 
                   RowBox[{
                    RowBox[{"DeleteCases", "[", 
                    RowBox[{"#", ",", 
                    RowBox[{"UndirectedEdge", "[", 
                    RowBox[{"a_", ",", "a_"}], "]"}]}], "]"}], "&"}]}]}], 
                 "]"}]}]}], 
              RowBox[{"(*", 
               RowBox[{
               "record", " ", "the", " ", "change", " ", "of", " ", 
                "vertices"}], "*)"}], ",", "\[IndentingNewLine]", 
              RowBox[{"{", 
               RowBox[{"k", ",", "6"}], "}"}]}], "]"}], ";"}]}], 
          "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"kk", "++"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Values", "[", "seen", "]"}], ",", "exr", ",", "graph", ",", 
        "graphv", ",", "exm"}], "}"}]}]}], "\[IndentingNewLine]", "]"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.966662789821793*^9, 3.966662789823353*^9}, {
   3.96666282666956*^9, 3.96666283100409*^9}, 3.966662881874145*^9, {
   3.966662919924617*^9, 3.966662968566255*^9}, 3.966663048920753*^9, {
