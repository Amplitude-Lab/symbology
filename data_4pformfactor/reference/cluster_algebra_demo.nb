Cell[BoxData[
 RowBox[{
  RowBox[{"cycrep", "=", 
   RowBox[{"Prepend", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"a", "[", 
              RowBox[{"i", ",", "j"}], "]"}], "->", 
             RowBox[{"a", "[", 
              RowBox[{"i", ",", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"j", "+", "k"}], ">", "7"}], ",", 
                 RowBox[{"Mod", "[", 
                  RowBox[{
                   RowBox[{"j", "+", "k"}], ",", "7"}], "]"}], ",", 
                 RowBox[{"j", "+", "k"}]}], "]"}]}], "]"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "1", ",", "6"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"j", ",", "1", ",", "7"}], "}"}]}], "]"}], "//", 
          "Flatten"}], ")"}], "/.", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"a", "[", 
           RowBox[{"i_", ",", "j_"}], "]"}], ":>", 
          RowBox[{"ToExpression", "[", 
           RowBox[{"\"\<a\>\"", "<>", 
            RowBox[{"ToString", "[", "i", "]"}], "<>", 
            RowBox[{"ToString", "[", "j", "]"}]}], "]"}]}], "}"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"k", ",", "1", ",", "6"}], "}"}]}], "]"}], ",", 
     RowBox[{"Thread", "@", 
      RowBox[{"Rule", "[", 
       RowBox[{"alphabet42", ",", "alphabet42"}], "]"}]}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.974977083903326*^9, 3.974977088495481*^9}, {
  3.974979026577798*^9, 3.974979049916848*^9}},
