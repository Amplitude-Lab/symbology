 RowBox[{
  RowBox[{"adjpair3s", "=", 
   RowBox[{"adjpair3s", "//", 
    RowBox[{
     RowBox[{"Select", "[", 
      RowBox[{"#", ",", 
       RowBox[{
        RowBox[{
