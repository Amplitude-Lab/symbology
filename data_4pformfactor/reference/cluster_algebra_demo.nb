 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "SpecialSimplify", "]"}], ";"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "there", " ", "is", " ", "a", " ", "special", " ", "case", " ", "we", " ",
      "will", " ", "use", " ", "a", " ", "lot", " ", "in", " ", "the", " ", 
     "calculation"}], ",", " ", 
    RowBox[{
    "the", " ", "simplification", " ", "of", " ", "which", " ", "we", " ", 
     "encode", " ", "by", " ", "hand"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"SpecialSimplify", "[", 
    RowBox[{"list1_", ",", "list2_", ",", "pair_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "int", ",", "res", ",", "res1", ",", "tem", ",", "p", ",", "p1", ",", 
       "p2", ",", "p3", ",", "p4", ",", "int2", ",", "int3", ",", "e", ",", 
       "sig", ",", "sig1"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"FreeQ", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"list1", ",", "list2"}], "}"}], ",", "Int"}], "]"}], ",", 
        RowBox[{"Return", "[", "False", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "pair", "]"}], "==", "1"}], "&&", 
         RowBox[{"FreeQ", "[", 
          RowBox[{"pair", ",", "Int"}], "]"}]}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"int", "=", 
          RowBox[{"Intersection", "[", 
           RowBox[{"Sequence", "@@", 
            RowBox[{"(", 
             RowBox[{"pair", "[", 
              RowBox[{"[", "1", "]"}], "]"}], ")"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"res", "=", 
          RowBox[{"{", 
