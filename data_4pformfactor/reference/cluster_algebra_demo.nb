Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "ToMT", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "ToMT", "]"}], "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\"\<loopvar\>\"", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"A", ",", "B"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"C", ",", "D"}], "}"}]}], "}"}]}], ",", 
     RowBox[{"\"\<keeporder\>\"", "->", "True"}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ToMT", "[", 
    RowBox[{"exp_", ",", "n_", ",", 
     RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"OptionValue", "[", "\"\<keeporder\>\"", "]"}], ",", 
     RowBox[{"exp", "/.", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"d", "[", 
          RowBox[{
           RowBox[{"x", "[", "a_", "]"}], ",", 
           RowBox[{"x", "[", "b_", "]"}]}], "]"}], ":>", 
         RowBox[{"FBI", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Mod", "[", 
             RowBox[{
              RowBox[{"a", "-", "2"}], ",", "n"}], "]"}], "+", "1"}], ",", 
           "a", ",", 
           RowBox[{
            RowBox[{"Mod", "[", 
             RowBox[{
              RowBox[{"b", "-", "2"}], ",", "n"}], "]"}], "+", "1"}], ",", 
           "b"}], "]"}]}], ",", 
        RowBox[{
         RowBox[{"d", "[", 
          RowBox[{
           RowBox[{"x", "[", "a_", "]"}], ",", 
           RowBox[{"y", "[", "i_", "]"}]}], "]"}], ":>", 
         RowBox[{"FBI", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"OptionValue", "[", "\"\<loopvar\>\"", "]"}], "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "1"}], "]"}], "]"}], ",", 
           RowBox[{
            RowBox[{"OptionValue", "[", "\"\<loopvar\>\"", "]"}], "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "2"}], "]"}], "]"}], ",", 
           RowBox[{
            RowBox[{"Mod", "[", 
             RowBox[{
              RowBox[{"a", "-", "2"}], ",", "n"}], "]"}], "+", "1"}], ",", 
           "a"}], "]"}]}], ",", 
        RowBox[{
         RowBox[{"d", "[", 
          RowBox[{
           RowBox[{"y", "[", "a_", "]"}], ",", 
           RowBox[{"y", "[", "b_", "]"}]}], "]"}], ":>", 
         RowBox[{"FBI", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"OptionValue", "[", "\"\<loopvar\>\"", "]"}], "[", 
            RowBox[{"[", 
             RowBox[{"a", ",", "1"}], "]"}], "]"}], ",", 
           RowBox[{
            RowBox[{"OptionValue", "[", "\"\<loopvar\>\"", "]"}], "[", 
            RowBox[{"[", 
             RowBox[{"a", ",", "2"}], "]"}], "]"}], ",", 
           RowBox[{
            RowBox[{"OptionValue", "[", "\"\<loopvar\>\"", "]"}], "[", 
            RowBox[{"[", 
             RowBox[{"b", ",", "1"}], "]"}], "]"}], ",", 
           RowBox[{
            RowBox[{"OptionValue", "[", "\"\<loopvar\>\"", "]"}], "[", 
            RowBox[{"[", 
             RowBox[{"b", ",", "2"}], "]"}], "]"}]}], "]"}]}]}], "}"}]}], ",", 
     RowBox[{"exp", "/.", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"d", "[", 
          RowBox[{
           RowBox[{"x", "[", "a_", "]"}], ",", 
           RowBox[{"x", "[", "b_", "]"}]}], "]"}], ":>", 
         RowBox[{"FB", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Mod", "[", 
             RowBox[{
              RowBox[{"a", "-", "2"}], ",", "n"}], "]"}], "+", "1"}], ",", 
