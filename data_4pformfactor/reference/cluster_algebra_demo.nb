          RowBox[{
           RowBox[{"a", "[", 
            RowBox[{"2", ",", "#"}], "]"}], "&"}], "/@", 
          RowBox[{"Range", "[", "7", "]"}]}], ",", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"a", "[", 
              RowBox[{"3", ",", "#"}], "]"}], "&"}], "/@", 
            RowBox[{"Range", "[", "7", "]"}]}], "/.", 
