                 RowBox[{"1", ",", "2"}], "]"}], "]"}]}], "]"}], "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], "}"}]}], ";", 
         RowBox[{"(*", 
          RowBox[{"the", " ", "other", " ", "term"}], "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{"tem", "=", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"Cases", "[", 
               RowBox[{"#", ",", 
