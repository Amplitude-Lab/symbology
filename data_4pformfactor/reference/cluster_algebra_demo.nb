 RowBox[{
  RowBox[{
   RowBox[{"FBCombine", "[", 
    RowBox[{"exp_", ",", 
     RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"tem", ",", "nd", ",", "sim"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"Not", "@", 
         RowBox[{"FreeQ", "[", 
          RowBox[{"exp", ",", "Int"}], "]"}]}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"nd", "=", 
          RowBox[{"FactorList", "[", "exp", "]"}]}], ";", 
         RowBox[{"(*", 
          RowBox[{
          "first", " ", "don", " ", "not", " ", "expand", " ", "the", " ", 
           "expression"}], "*)"}], "\[IndentingNewLine]", 
         RowBox[{"sim", "=", 
          RowBox[{
           RowBox[{"Reap", "[", 
            RowBox[{"Do", "[", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{"NumericQ", "[", 
                  RowBox[{"nd", "[", 
                   RowBox[{"[", 
                    RowBox[{"i", ",", "1"}], "]"}], "]"}], "]"}], ",", 
                 RowBox[{
                  RowBox[{"Sow", "[", 
                   RowBox[{"nd", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "]"}], ";", 
                  RowBox[{"Continue", "[", "]"}]}]}], "]"}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"Sow", "[", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"nd", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ",", "1"}], "]"}], "]"}], "//", 
                   "FBCombineR"}], ",", 
                  RowBox[{"nd", "[", 
                   RowBox[{"[", 
                    RowBox[{"i", ",", "2"}], "]"}], "]"}]}], "}"}], "]"}]}], 
              "\[IndentingNewLine]", ",", 
              RowBox[{"{", 
               RowBox[{"i", ",", "1", ",", 
                RowBox[{"Length", "[", "nd", "]"}]}], "}"}]}], "]"}], 
            "\[IndentingNewLine]", "]"}], "[", 
           RowBox[{"[", 
            RowBox[{"2", ",", "1"}], "]"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"tem", "=", 
          RowBox[{"(", 
           RowBox[{"Times", "@@", 
            RowBox[{"Power", "@@@", "sim"}]}], ")"}]}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"tem", "=", "exp"}]}], "\[IndentingNewLine]", "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"nd", "=", 
       RowBox[{"FactorList", "[", 
        RowBox[{"tem", "//", "MTExpand"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"sim", "=", 
