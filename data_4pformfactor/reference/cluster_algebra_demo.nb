                 RowBox[{"f", ",", "g"}], "]"}]}], "]"}]}], ",", 
             RowBox[{
              RowBox[{"ab", "[", "a__", "]"}], ":>", 
              RowBox[{"FB", "[", "a", "]"}]}]}], "}"}]}], "//", "MTExpand"}], 
         ")"}], "/.", 
        RowBox[{"{", 
