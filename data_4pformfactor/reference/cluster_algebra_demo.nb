  RowBox[{"ClearAll", "[", "EllipticAdd", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"EllipticAdd", "[", 
    RowBox[{"curve_", ",", "P_", ",", "Q_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "sol", ",", "lam", ",", "nu", ",", "sol1", ",", "tem", ",", "pos"}], 
      "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"P", "===", "Infinity"}], ",", 
        RowBox[{"Return", "[", "Q", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"Q", "===", "Infinity"}], ",", 
        RowBox[{"Return", "[", "P", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"P", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "==", 
         RowBox[{"Q", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], ",", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"P", "[", 
            RowBox[{"[", "2", "]"}], "]"}], "!=", 
           RowBox[{"Q", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], ",", 
          RowBox[{"Return", "[", "Infinity", "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"tem", "=", 
            RowBox[{"curve", "/.", 
             RowBox[{"{", 
              RowBox[{"y", "->", "0"}], "}"}]}]}], ";", 
           RowBox[{"sol", "=", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"lam", "->", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"-", 
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"D", "[", 
                    RowBox[{"tem", ",", "x"}], "]"}], "/", "2"}], "y"}], 
                   ")"}]}], "/.", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"x", "->", 
                    RowBox[{"P", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}], ",", 
                   RowBox[{"y", "->", 
                    RowBox[{"P", "[", 
                    RowBox[{"[", "2", "]"}], "]"}]}]}], "}"}]}], ")"}]}], ",", 
              RowBox[{"nu", "->", 
               RowBox[{
                RowBox[{"P", "[", 
                 RowBox[{"[", "2", "]"}], "]"}], "-", 
                RowBox[{"lam", "*", 
                 RowBox[{"P", "[", 
                  RowBox[{"[", "1", "]"}], "]"}]}]}]}]}], "}"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"sol", "=", 
            RowBox[{"{", 
             RowBox[{"y", "->", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"lam", "*", "x"}], "+", "nu"}], ")"}], "//.", 
                "sol"}], ")"}]}], "}"}]}]}]}], "\[IndentingNewLine]", "]"}], 
        ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"P", "[", 
             RowBox[{"[", "2", "]"}], "]"}], "==", 
            RowBox[{"Q", "[", 
             RowBox[{"[", "2", "]"}], "]"}]}], ",", "\[IndentingNewLine]", 
           RowBox[{"sol", "=", 
            RowBox[{"{", 
             RowBox[{"y", "->", 
              RowBox[{"P", "[", 
               RowBox[{"[", "2", "]"}], "]"}]}], "}"}]}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"sol", "=", 
             RowBox[{
              RowBox[{"Solve", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"nu", "==", 
                   RowBox[{
                    RowBox[{"P", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], "-", 
                    RowBox[{"lam", "*", 
                    RowBox[{"P", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}]}]}], ",", 
                  RowBox[{"nu", "==", 
                   RowBox[{
                    RowBox[{"Q", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], "-", 
                    RowBox[{"lam", "*", 
                    RowBox[{"Q", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}]}]}]}], "}"}], ",", 
                RowBox[{"{", 
                 RowBox[{"lam", ",", "nu"}], "}"}]}], "]"}], "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"sol", "=", 
             RowBox[{"{", 
              RowBox[{"y", "->", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"lam", "*", "x"}], "+", "nu"}], ")"}], "/.", 
                 "sol"}], ")"}]}], "}"}]}]}]}], "\[IndentingNewLine]", "]"}], 
         ";"}]}], "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"sol1", "=", 
       RowBox[{"Solve", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"curve", "/.", "sol"}], ")"}], "==", "0"}], ",", "x"}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"tem", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"P", "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", 
         RowBox[{"Q", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], "}"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Do", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"pos", "=", 
          RowBox[{
           RowBox[{"Position", "[", 
            RowBox[{"sol1", ",", 
             RowBox[{"tem", "[", 
              RowBox[{"[", "i", "]"}], "]"}]}], "]"}], "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"sol1", "=", 
          RowBox[{"Delete", "[", 
           RowBox[{"sol1", ",", "pos"}], "]"}]}]}], "\[IndentingNewLine]", 
        ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", "2"}], "}"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Return", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"x", "/.", 
          RowBox[{"sol1", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "y"}], "/.", "sol"}], "/.", 
          RowBox[{"sol1", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}]}], "}"}], "]"}], ";"}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.926572988976987*^9, 3.9265730293622713`*^9}, {
