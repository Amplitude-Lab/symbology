Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "FBCancel", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "FBCancel", "]"}], "=", 
   RowBox[{"{", 
    RowBox[{"deBug", "->", "False"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"FBCancel", "[", 
    RowBox[{"exp_", ",", 
     RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "nd", ",", "al", ",", "fac", ",", "rep", ",", "sub", ",", "nl", ",", 
       RowBox[{"result", "=", 
        RowBox[{"{", "}"}]}], ",", "sim", ",", "pos"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"nd", "=", 
       RowBox[{"FactorList", "[", "exp", "]"}]}], ";", "\[IndentingNewLine]", 
      
      RowBox[{"fac", "=", 
       RowBox[{
        RowBox[{"nd", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "1"}], "]"}], "]"}], "//", "MTExpand"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"OptionValue", "[", "deBug", "]"}], ",", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<fac: \>\"", ",", "fac"}], "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"al", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"a", "[", "i", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", 
           RowBox[{"Length", "[", "fac", "]"}]}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"sub", "=", 
       RowBox[{"Subsets", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"a", "[", "i", "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "1", ",", 
             RowBox[{"Length", "[", "fac", "]"}]}], "}"}]}], "]"}], ",", 
         RowBox[{"{", "2", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "generate", " ", "a", " ", "set", " ", "of", " ", "random", " ", 
        "number", " ", "and", " ", "check", " ", "which", " ", "terms", " ", 
        "are", " ", "actually", " ", "the", " ", "same", " ", "with", " ", 
        "each", " ", "other"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"Do", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"nl", "=", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"RandomPrime", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"10", "^", "4"}], ",", 
                RowBox[{"10", "^", "6"}]}], "}"}], ",", "4"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"j", ",", "1", ",", "20"}], "}"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"rep", "=", 
          RowBox[{"Thread", "@", 
           RowBox[{"Rule", "[", 
            RowBox[{"al", ",", 
             RowBox[{"fac", "/.", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"FB", "[", "a__", "]"}], ":>", 
                RowBox[{"fB", "[", 
                 RowBox[{
                  RowBox[{"{", "a", "}"}], ",", 
                  RowBox[{"\"\<explicitM\>\"", "->", "nl"}]}], "]"}]}], 
               "}"}]}]}], "]"}]}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"AppendTo", "[", 
          RowBox[{"result", ",", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"#", "[", 
                RowBox[{"[", "2", "]"}], "]"}], "/", 
               RowBox[{"#", "[", 
                RowBox[{"[", "1", "]"}], "]"}]}], ")"}], "&"}], "/@", 
            RowBox[{"(", 
             RowBox[{"sub", "/.", "rep"}], ")"}]}]}], "]"}]}], 
        "\[IndentingNewLine]", ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", "3"}], "}"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"result", "=", 
       RowBox[{"Union", "/@", 
        RowBox[{"(", 
         RowBox[{"result", "//", "Transpose"}], ")"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"OptionValue", "[", "deBug", "]"}], ",", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<result: \>\"", ",", "result"}], "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"pos", "=", 
       RowBox[{
        RowBox[{"Position", "[", 
         RowBox[{"result", ",", 
          RowBox[{"_", "?", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"Length", "[", "#", "]"}], "==", "1"}], "&"}], 
            ")"}]}]}], "]"}], "//", "Flatten"}]}], ";", 
      RowBox[{"(*", 
       RowBox[{
       "select", " ", "terms", " ", "that", " ", "are", " ", "relevant"}], 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"pos", "===", 
         RowBox[{"{", "}"}]}], ",", 
        RowBox[{"Return", "[", "exp", "]"}]}], "]"}], ";", 
      RowBox[{"(*", 
       RowBox[{
       "this", " ", "expression", " ", "can", " ", "not", " ", "be", " ", 
        "simplified"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"rep", "=", 
       RowBox[{
        RowBox[{"Reap", "[", "\[IndentingNewLine]", 
         RowBox[{"Do", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Sow", "[", 
            RowBox[{"Rule", "[", 
             RowBox[{
              RowBox[{"sub", "[", 
               RowBox[{"[", 
                RowBox[{
                 RowBox[{"pos", "[", 
                  RowBox[{"[", "i", "]"}], "]"}], ",", "2"}], "]"}], "]"}], 
              ",", 
              RowBox[{
               RowBox[{"sub", "[", 
                RowBox[{"[", 
                 RowBox[{
                  RowBox[{"pos", "[", 
                   RowBox[{"[", "i", "]"}], "]"}], ",", "1"}], "]"}], "]"}], 
               "*", 
               RowBox[{"result", "[", 
                RowBox[{"[", 
                 RowBox[{
                  RowBox[{"pos", "[", 
                   RowBox[{"[", "i", "]"}], "]"}], ",", "1"}], "]"}], 
                "]"}]}]}], "]"}], "]"}], "\[IndentingNewLine]", ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "1", ",", 
             RowBox[{"Length", "[", "pos", "]"}]}], "}"}]}], "]"}], 
         "\[IndentingNewLine]", "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"2", ",", "1"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      
      RowBox[{"fac", "=", 
       RowBox[{
        RowBox[{"Partition", "[", 
         RowBox[{
          RowBox[{"Riffle", "[", 
           RowBox[{"al", ",", 
            RowBox[{"nd", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", "2"}], "]"}], "]"}]}], "]"}], ",", "2"}], 
         "]"}], "/.", "rep"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"rep", "=", 
       RowBox[{"Thread", "@", 
        RowBox[{"Rule", "[", 
         RowBox[{"al", ",", 
          RowBox[{"nd", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "1"}], "]"}], "]"}]}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Return", "[", 
       RowBox[{"Times", "@@", 
        RowBox[{"Power", "@@@", 
         RowBox[{"(", 
          RowBox[{"fac", "/.", "rep"}], ")"}]}]}], "]"}], ";"}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",
