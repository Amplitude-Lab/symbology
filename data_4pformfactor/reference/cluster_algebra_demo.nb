   RowBox[{"FBToNum", "::", "usage"}], "=", 
   "\"\<Transform the expression of FB[__] to numeric values.\>\""}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "FBToNum", "]"}], "=", 
   RowBox[{"{", 
    RowBox[{"\"\<explicitM\>\"", "->", 
     RowBox[{"{", "}"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"FBToNum", "[", 
    RowBox[{"exp_", ",", 
     RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"exp", "//", "MTExpand"}], ")"}], "/.", 
    RowBox[{"{", 
     RowBox[{
