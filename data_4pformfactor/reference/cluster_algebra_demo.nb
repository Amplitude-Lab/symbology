           RowBox[{
            RowBox[{"Mod", "[", 
             RowBox[{
              RowBox[{"b", "-", "2"}], ",", "n"}], "]"}], "+", "1"}], ",", 
           "b"}], "]"}]}], ",", 
        RowBox[{
         RowBox[{"d", "[", 
          RowBox[{
           RowBox[{"x", "[", "a_", "]"}], ",", 
           RowBox[{"y", "[", "i_", "]"}]}], "]"}], ":>", 
         RowBox[{"FB", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"OptionValue", "[", "\"\<loopvar\>\"", "]"}], "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "1"}], "]"}], "]"}], ",", 
           RowBox[{
            RowBox[{"OptionValue", "[", "\"\<loopvar\>\"", "]"}], "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "2"}], "]"}], "]"}], ",", 
           RowBox[{
            RowBox[{"Mod", "[", 
             RowBox[{
              RowBox[{"a", "-", "2"}], ",", "n"}], "]"}], "+", "1"}], ",", 
           "a"}], "]"}]}], ",", 
        RowBox[{
         RowBox[{"d", "[", 
          RowBox[{
           RowBox[{"y", "[", "a_", "]"}], ",", 
           RowBox[{"y", "[", "b_", "]"}]}], "]"}], ":>", 
         RowBox[{"FB", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"OptionValue", "[", "\"\<loopvar\>\"", "]"}], "[", 
