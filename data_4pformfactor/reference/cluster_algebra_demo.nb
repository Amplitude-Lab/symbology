            ",", 
            RowBox[{"Complement", "[", 
             RowBox[{
              RowBox[{"pair", "[", 
               RowBox[{"[", 
                RowBox[{"1", ",", "2"}], "]"}], "]"}], ",", "int"}], "]"}]}], 
           "}"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"res1", "=", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"DeleteCases", "[", 
              RowBox[{"list1", ",", 
               RowBox[{"pair", "[", 
                RowBox[{"[", 
                 RowBox[{"1", ",", "1"}], "]"}], "]"}]}], "]"}], "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", 
            RowBox[{
             RowBox[{"DeleteCases", "[", 
              RowBox[{"list2", ",", 
