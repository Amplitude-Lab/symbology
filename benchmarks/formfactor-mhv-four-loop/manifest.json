  "candidate_bytes": 22457737,
  "native_tensor_dimensions": [
    1,
    35598,
    175
  ],
  "nonzero_coefficients": 988559,
  "structure": "S4 = sum C[1,i,a] P6_i (x) Q2_a; P6 from FEC_1..FEC_6 prefix recursion, Q2 from suffix_TF175_physical",
  "conditional_hypotheses": [
    "retained 88-letter alphabet (96-letter enlargement has the same solution space through weight 8)",
    "proposed adjacency pair spaces (interior.wxf + adjacency_symmetric.json + first_pair.json)",
    "continued twelve-dimensional literature remainder TR12 last-entry space",
    "external Steinmann equations not imposed",
    "finite four-loop targets not used in solving (reserved as holdouts)"
  ],
  "accepted_chain": [
    "prefix bases FEC_2..FEC_6 via bootstrap --extend (FEC_6 503 MB regenerated, not committed)",
    "cyclic/flip/galois generator actions lifted onto the FEC/LEC bases (galois, galois_suffix, actions helpers); no irreducible-representation decomposition is used anywhere in the chain (the unused isotypic experiment is archived under experimental/symrep-isotypic-sewing/)",
    "suffix chain LEC_1..LEC_4 (the cyclic LEC_2 projection receipt failed, exit 1, output unconsumed)",
    "weight-8 sewing SEW_6p2, invariant masked sewing, affine TR extraction (augmented kernel dim 4, affine dim 3)",
    "DC exact affine boundary solve: affine dim 3 -> 0 (26 s measured, 141 nonzero + 343 zero pair blocks)",
    "TC exact affine boundary solve consuming the DC solution: affine dim 0 retained (52 s measured)",
    "reserved DC/TC holdout comparisons vs published four-loop remainders: exact equality",
    "independent Python audits: extraction, final coordinate chain, evidence chain"
  ],
  "fully_optimized_claimed": false,
  "cold_end_to_end_measured": false,
  "uniqueness_scope": "Unique tensor within the explicit proposed-adjacency and continued-TR12 hypotheses; not uniqueness in the larger extended-Steinmann space; no all-loop claim; no comparison to a separately known full four-loop parent symbol",
