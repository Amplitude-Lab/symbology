$HistoryLength=0;SetSystemOptions["ParallelOptions"->"ParallelThreadNumber"->4];base=DirectoryName[DirectoryName[DirectoryName[$InputFileName]]];out=base<>"/results/ff_four_loop";src=base<>"/results/ff_bootstrap/data";start=AbsoluteTime[];
readJSON[f_]:=Module[{d=Import[f,"RawJSON"]},SparseArray[(First[#]->ToExpression[Last[#]])&/@d["rules"],d["dimensions"]]];
a=readJSON[out<>"/data/adjacency_symmetric.json"];pure=Import[src<>"/pure.wxf"];t=Join[pure,a,3];Export[out<>"/data/interior.wxf",t,"WXF"];f=readJSON[out<>"/data/first_pair.json"];Export[out<>"/FEC_2.wxf",f,"WXF"];
Do[CopyFile[src<>"/"<>name,out<>"/data/"<>name,OverwriteTarget->True],{name,{"FEC_1.wxf","LEC_1.wxf","cycmat.wxf","flipmat.wxf","cycrepmat.wxf","fliprepmat.wxf","galois1a.wxf","galois1b.wxf","galois2a.wxf","galois2b.wxf","galois3.wxf","letter_indices.json"}}];CopyFile[src<>"/FEC_1.wxf",out<>"/FEC_1.wxf",OverwriteTarget->True];Export[out<>"/prepare.json",<|"condition_dimensions"->Dimensions[t],"condition_nonzeros"->Length[t["NonzeroValues"]],"first_pair_dimensions"->Dimensions[f],"seconds"->AbsoluteTime[]-start,"memory_bytes"->MaxMemoryUsed[]|>,"RawJSON"];Print[Import[out<>"/prepare.json","RawJSON"]];
