$HistoryLength=0;base=DirectoryName[DirectoryName[$InputFileName]];r=base<>"/results";p=r<>"/ff_bootstrap/steinmann";out=r<>"/ff_four_loop";If[!DirectoryQ[out],CreateDirectory[out]];files={p<>"/affine/final_compact_w6.wxf",p<>"/collinear/first_w5.wxf",p<>"/triple/collinear/first_w5.wxf",p<>"/affine/reconstructed_w4.wxf",r<>"/ff_boot_boundary_F41.wxf"};receipt={};Do[t=AbsoluteTime[];a=Import[f];AppendTo[receipt,<|"file"->StringDrop[f,StringLength[base]+1],"head"->ToString[Head[a]],"dimensions"->Dimensions[a],"bytes"->ByteCount[a],"seconds"->AbsoluteTime[]-t|>];Clear[a],{f,files}];Export[out<>"/H8_profile.json",<|"inputs"->receipt,"max_memory_bytes"->MaxMemoryUsed[]|>,"RawJSON"];Print[receipt];
