$HistoryLength=0;SetSystemOptions["ParallelOptions"->"ParallelThreadNumber"->1];base=DirectoryName[DirectoryName[$InputFileName]];out=base<>"/results/ff_four_loop";start=AbsoluteTime[];
zero[x_]:=AllTrue[Flatten[Normal[x]],TrueQ[#==0]&];q=3;f=2;d=5;
e=SparseArray[{{1,1}->1,{1,5}->1,{2,2}->2,{2,4}->3,{3,3}->1,{3,7}->1,{4,2}->1,{4,6}->1,{5,9}->1,{5,4}->1},{5,9}];
a=IdentityMatrix[5]+SparseArray[Table[{k,k+1}->k+1,{k,4}],{5,5}];physical=a.e;good=IdentityMatrix[5][[1;;2]].Inverse[a];normal=Select[RowReduce[Normal[good]],Total[Abs[#]]!=0&];piv=First@FirstPosition[#,x_/;x!=0]&/@normal;free=Complement[Range[d],piv];quot=ConstantArray[0,{d,Length[free]}];quot[[free]]=IdentityMatrix[Length[free]];quot[[piv]]=-normal[[All,free]];
t=IdentityMatrix[15]+SparseArray[Table[{k,k+1}->(-1)^k(k+1),{k,14}],{15,15}];c=ConstantArray[0,{15,(d-Length[good])f+d(q-f)}];Do[p=Quotient[j-1,q]+1;l=Mod[j-1,q]+1;If[l>f,c[[All,(d-Length[good])f+(p-1)(q-f)+l-f]]+=t[[All,j]],Do[c[[All,(k-1)f+l]]+=t[[All,j]]quot[[p,k]],{k,Length[free]}]],{j,15}];
actual=t.KroneckerProduct[physical,IdentityMatrix[q]];spur=Select[Range[q^3],MemberQ[IntegerDigits[#-1,q,3],2]&];recursive=NullSpace[Transpose[c]];direct=NullSpace[Transpose[actual[[All,spur]]]];naive=NullSpace[Transpose[t[[All,Range[3,15,3]]]]];
checks=<|"arbitrary_basis_is_invertible"->(Det[a]!=0),"previous_regular_exact_physical_subspace"->zero[good.physical[[All,Select[Range[q^2],MemberQ[IntegerDigits[#-1,q,2],2]&]]]],"quotient_annihilates_regular_basis"->zero[good.quot],"quotient_rank_complete"->(MatrixRank[quot]==d-Length[good]),"recursive_equals_full_actual_word_regular_kernel"->(RowReduce[recursive]==RowReduce[direct]),"both_regular_dimensions_four"->(Length[recursive]==4&&Length[direct]==4),"all_actual_spurious_word_residuals_zero"->zero[recursive.actual[[All,spur]]],"last_letter_only_test_incorrectly_keeps_ten"->(Length[naive]==10)|>;
r=<|"all_checks_pass"->And@@Values[checks],"checks"->checks,"fixture"->"Arbitrary nonorthogonal five-dimensional previous prefix space in a three-letter weight2 tensor; two finite letters, two-dimensional regular subspace; invertibly mixed full15-dimensional next carrier. Direct all27 physical words compared to recursive quotient.","proof"->"For finite last letters project the previous prefix onto E/U; for spurious last letters retain all of E. The direct-sum map has kernel U tensor Vfinite. Normalized pivot rows and the free identity block make the quotient kernel exactly U. Induction retains every word with a spurious letter anywhere.","completeness"->"Native modular rank lower bound and the independent free-coordinate kernel rows, together with exact residual zero, establish the full rational kernel.","cache_scope"->"Resumed regular_prefix files must come from the same source chain and finite-letter dictionary; existing code resumes by filename, so provenance must be checked by the caller.","finite_target_read"->False,"seconds"->AbsoluteTime[]-start,"maximum_Wolfram_memory_bytes"->MaxMemoryUsed[]|>;Export[out<>"/boundary_regular_independent_audit.json",r,"RawJSON"];Print[r];If[!TrueQ[r["all_checks_pass"]],Exit[2]];
